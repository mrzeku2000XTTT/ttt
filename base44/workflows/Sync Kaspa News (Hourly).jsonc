{
  "name": "Sync Kaspa News (Hourly)",
  "description": "Fetches latest Kaspa news from kaspa.news API across all feeds and populates KaspaNewsItem DB every hour.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 1,
      "interval_unit": "hours",
      "interval_anchor": "2026-04-15T22:26:55.978000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_kaspa_news_hourly",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncKaspaNews",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}