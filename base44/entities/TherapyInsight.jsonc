{
  "name": "TherapyInsight",
  "type": "object",
  "properties": {
    "insight_category": {
      "type": "string",
      "enum": [
        "anxiety",
        "depression",
        "relationships",
        "trauma",
        "stress",
        "self-esteem",
        "grief",
        "anger",
        "addiction",
        "general"
      ],
      "description": "Category of insight"
    },
    "pattern_detected": {
      "type": "string",
      "description": "Pattern or behavior identified"
    },
    "therapeutic_approach": {
      "type": "string",
      "description": "Recommended therapeutic approach"
    },
    "success_rate": {
      "type": "number",
      "default": 0,
      "description": "Success rate of this insight"
    },
    "times_applied": {
      "type": "number",
      "default": 0,
      "description": "Number of times this insight was used"
    },
    "source_sessions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Session IDs where this was learned"
    }
  },
  "required": [
    "insight_category",
    "pattern_detected"
  ],
  "rls": {
    "create": {
      "user.role": "admin"
    },
    "read": true,
    "update": {
      "user.role": "admin"
    },
    "delete": {
      "user.role": "admin"
    }
  }
}