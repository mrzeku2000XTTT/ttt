{
  "name": "ClutchClip",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "creator_name": {
      "type": "string",
      "maxLength": 40
    },
    "creator_wallet": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "upload",
        "youtube"
      ]
    },
    "file_uri": {
      "type": "string"
    },
    "original_file_uri": {
      "type": "string"
    },
    "youtube_id": {
      "type": "string"
    },
    "caption": {
      "type": "string",
      "maxLength": 500
    },
    "duration_seconds": {
      "type": "number",
      "maximum": 60
    },
    "edit_start_seconds": {
      "type": "number",
      "minimum": 0
    },
    "edit_end_seconds": {
      "type": "number",
      "minimum": 0
    },
    "ai_edit_summary": {
      "type": "string",
      "maxLength": 500
    },
    "ai_edited": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "creator_name",
    "creator_wallet",
    "source_type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}