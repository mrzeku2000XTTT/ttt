{
  "name": "RufzeitKBypassCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "The bypass code string"
    },
    "label": {
      "type": "string",
      "description": "Admin label for this code (e.g. who it's for)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this code is still valid"
    },
    "uses_remaining": {
      "type": "number",
      "default": -1,
      "description": "How many times it can be used. -1 = unlimited"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "code"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}