{
  "name": "ShopItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Item title"
    },
    "description": {
      "type": "string",
      "description": "Detailed description"
    },
    "price_kas": {
      "type": "number",
      "description": "Price in KAS"
    },
    "category": {
      "type": "string",
      "enum": [
        "electronics",
        "fashion",
        "home",
        "collectibles",
        "art",
        "crypto",
        "books",
        "sports",
        "toys",
        "services",
        "other"
      ],
      "description": "Item category"
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "like_new",
        "good",
        "fair",
        "poor"
      ],
      "default": "new",
      "description": "Item condition"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of image URLs"
    },
    "seller_email": {
      "type": "string",
      "description": "Seller's email"
    },
    "seller_username": {
      "type": "string",
      "description": "Seller's display name"
    },
    "seller_kaspa_address": {
      "type": "string",
      "description": "Seller's Kaspa wallet address (L1)"
    },
    "seller_metamask_address": {
      "type": "string",
      "description": "Seller's MetaMask address (for ZEKU payments)"
    },
    "location": {
      "type": "string",
      "description": "Item location"
    },
    "shipping_cost_kas": {
      "type": "number",
      "default": 0,
      "description": "Shipping cost in KAS"
    },
    "stock": {
      "type": "number",
      "default": 1,
      "description": "Available quantity"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "sold",
        "pending",
        "inactive"
      ],
      "default": "active",
      "description": "Item status"
    },
    "views": {
      "type": "number",
      "default": 0,
      "description": "Number of views"
    },
    "favorites": {
      "type": "number",
      "default": 0,
      "description": "Number of favorites"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Search tags"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Featured item"
    }
  },
  "required": [
    "title",
    "description",
    "price_kas",
    "category",
    "seller_email",
    "seller_kaspa_address"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}