{
  "name": "ClaimedItem",
  "type": "object",
  "properties": {
    "wishlist_item_id": {
      "type": "string",
      "description": "Reference to wishlist item"
    },
    "cart_id": {
      "type": "string",
      "description": "Reference to cart if from cart"
    },
    "claimer_email": {
      "type": "string",
      "description": "Who claimed it (anonymous to owner)"
    },
    "claimer_name": {
      "type": "string",
      "description": "Claimer's display name"
    },
    "is_purchased": {
      "type": "boolean",
      "default": false,
      "description": "Whether claimer purchased it"
    }
  },
  "required": [
    "wishlist_item_id",
    "claimer_email"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "claimer_email": "{{user.email}}"
        },
        {
          "user.role": "admin"
        }
      ]
    },
    "update": {
      "claimer_email": "{{user.email}}"
    },
    "delete": {
      "claimer_email": "{{user.email}}"
    }
  }
}