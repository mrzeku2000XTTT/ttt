{
  "name": "CollabPresence",
  "type": "object",
  "properties": {
    "wallet_address": {
      "type": "string",
      "description": "Collaborator's Kaspa wallet address"
    },
    "display_name": {
      "type": "string",
      "default": "",
      "description": "Optional display name"
    },
    "last_heartbeat": {
      "type": "string",
      "format": "date-time",
      "description": "Last presence ping timestamp"
    }
  },
  "required": [
    "wallet_address"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.wallet_address": "{{user.data.kaspa_address}}"
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.wallet_address": "{{user.data.kaspa_address}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.wallet_address": "{{user.data.kaspa_address}}"
        }
      ]
    }
  }
}