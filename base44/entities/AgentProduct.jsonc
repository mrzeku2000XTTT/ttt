{
  "name": "AgentProduct",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Product name"
    },
    "description": {
      "type": "string",
      "description": "Short product description"
    },
    "html_content": {
      "type": "string",
      "description": "Full standalone HTML app code generated by AGENT"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "launched"
      ],
      "default": "launched",
      "description": "Product status"
    }
  },
  "required": [
    "title",
    "html_content"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}