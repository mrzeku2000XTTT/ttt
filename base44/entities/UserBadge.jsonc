{
  "name": "UserBadge",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "Username to assign badge to"
    },
    "badge_name": {
      "type": "string",
      "description": "Badge display name (e.g., MODZ, ARCHITECT, VIP)"
    },
    "badge_color": {
      "type": "string",
      "default": "cyan",
      "description": "Badge color: cyan, purple, yellow, red, green, blue, pink"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether badge is currently active"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "username",
    "badge_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}