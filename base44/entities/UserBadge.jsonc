{
  "name": "UserBadge",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "Username to assign badge to"
    },
    "badge_name": {
      "type": "string",
      "description": "Badge display name (e.g., MODZ, ARCHITECT, VIP)"
    },
    "badge_color": {
      "type": "string",
      "default": "cyan",
      "description": "Badge color: cyan, purple, yellow, red, green, blue, pink"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether badge is currently active"
    }
  },
  "required": [
    "username",
    "badge_name"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}