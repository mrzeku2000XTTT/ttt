{
  "name": "ChestWallet",
  "type": "object",
  "properties": {
    "kaspa_address": {
      "type": "string",
      "description": "Chest wallet public address for receiving donations"
    },
    "seed_phrase": {
      "type": "string",
      "description": "Chest wallet seed phrase (admin only)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is the active chest wallet"
    },
    "label": {
      "type": "string",
      "default": "Community Chest",
      "description": "Wallet label"
    }
  },
  "required": [
    "kaspa_address",
    "seed_phrase"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}