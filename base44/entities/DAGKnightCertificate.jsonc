{
  "name": "DAGKnightCertificate",
  "type": "object",
  "properties": {
    "certificate_id": {
      "type": "string",
      "description": "Unique certificate ID"
    },
    "user_email": {
      "type": "string",
      "description": "User who owns this certificate"
    },
    "ttt_id": {
      "type": "string",
      "description": "Associated TTT ID"
    },
    "kasware_address": {
      "type": "string",
      "description": "Kasware L1 wallet address"
    },
    "kasware_verification_id": {
      "type": "string",
      "description": "Reference to Kasware verification"
    },
    "ttt_wallet_address": {
      "type": "string",
      "description": "TTT wallet address"
    },
    "ttt_verification_id": {
      "type": "string",
      "description": "Reference to TTT verification"
    },
    "metamask_address": {
      "type": "string",
      "description": "MetaMask L2 wallet address"
    },
    "metamask_verification_id": {
      "type": "string",
      "description": "Reference to MetaMask verification"
    },
    "total_blue_score": {
      "type": "number",
      "description": "Combined blue score of all verifications"
    },
    "total_dag_depth": {
      "type": "number",
      "description": "Maximum DAG depth achieved"
    },
    "cross_verifications_count": {
      "type": "number",
      "description": "Number of cross-verifications"
    },
    "issued_date": {
      "type": "string",
      "format": "date-time",
      "description": "When certificate was issued"
    },
    "is_stamped": {
      "type": "boolean",
      "default": false,
      "description": "Whether certificate is Kasware stamped"
    },
    "stamp_signature": {
      "type": "string",
      "description": "Kasware signature on certificate"
    },
    "stamp_message": {
      "type": "string",
      "description": "Message that was stamped"
    },
    "stamped_date": {
      "type": "string",
      "format": "date-time",
      "description": "When certificate was stamped"
    },
    "is_public": {
      "type": "boolean",
      "default": true,
      "description": "Whether certificate is publicly visible"
    },
    "certificate_hash": {
      "type": "string",
      "description": "SHA-256 hash of certificate data"
    }
  },
  "required": [
    "certificate_id",
    "user_email",
    "kasware_address",
    "ttt_wallet_address",
    "metamask_address"
  ],
  "rls": {
    "create": {
      "user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "is_public": true
        },
        {
          "user_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_email": "{{user.email}}"
    },
    "delete": {
      "user_email": "{{user.email}}"
    }
  }
}