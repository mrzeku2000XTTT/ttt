{
  "name": "MoodEntry",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User's email"
    },
    "mood": {
      "type": "string",
      "description": "Mood type"
    },
    "energy_level": {
      "type": "number",
      "description": "Energy level 1-10"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "frequency_used": {
      "type": "string",
      "description": "Frequency used during entry"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Entry date"
    }
  },
  "required": [
    "user_email",
    "mood",
    "energy_level",
    "date"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}