{
  "name": "NicheResult",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Owner email \u2014 only they can see or manage this niche"
    },
    "niche_name": {
      "type": "string",
      "description": "Niche title"
    },
    "tagline": {
      "type": "string",
      "description": "One-line positioning statement"
    },
    "passions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Passions the user picked when finding this niche"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Platforms the user plans to post on"
    },
    "result": {
      "type": "object",
      "description": "Full niche report: niche, strengths, audience, pillars, ideas, cadence"
    }
  },
  "required": [
    "user_email",
    "niche_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}