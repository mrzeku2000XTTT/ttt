{
  "name": "TruthEntry",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User who entered"
    },
    "entry_time": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of entry"
    },
    "tx_hash": {
      "type": "string",
      "description": "Transaction hash of the proof"
    }
  },
  "required": [
    "entry_time"
  ],
  "rls": {
    "create": true,
    "read": true
  }
}