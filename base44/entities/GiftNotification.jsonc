{
  "name": "GiftNotification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Notification recipient"
    },
    "type": {
      "type": "string",
      "enum": [
        "price_drop",
        "price_alert",
        "invitation",
        "item_claimed",
        "ai_suggestion"
      ],
      "description": "Notification type"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification message"
    },
    "item_id": {
      "type": "string",
      "description": "Related item"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Read status"
    },
    "action_url": {
      "type": "string",
      "description": "Link to relevant page"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "user_email",
    "type",
    "title",
    "message"
  ],
  "rls": {
    "create": null,
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}