{
  "name": "ProofOfLife",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User who submitted proof of life"
    },
    "wallet_address": {
      "type": "string",
      "description": "Wallet address that submitted the proof"
    },
    "wallet_type": {
      "type": "string",
      "enum": [
        "kasware_l1",
        "metamask_l2",
        "ttt_wallet"
      ],
      "description": "Type of wallet used"
    },
    "tx_hash": {
      "type": "string",
      "description": "Transaction hash of the self-transaction"
    },
    "amount": {
      "type": "number",
      "description": "Amount sent to self (usually small)"
    },
    "message": {
      "type": "string",
      "description": "Optional message from user"
    },
    "network": {
      "type": "string",
      "enum": [
        "L1",
        "L2"
      ],
      "description": "Which network was used"
    },
    "proof_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When proof was submitted"
    },
    "likes": {
      "type": "number",
      "default": 0,
      "description": "Number of likes from other users"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether transaction was verified on blockchain"
    },
    "mood": {
      "type": "number",
      "description": "User's mood rating (1-5)"
    },
    "ai_wellness_check": {
      "type": "object",
      "properties": {
        "feeling": {
          "type": "number",
          "description": "How user feels (1-5)"
        },
        "sleep": {
          "type": "boolean",
          "description": "Did user sleep well"
        },
        "pain": {
          "type": "boolean",
          "description": "Any pain or discomfort"
        },
        "medication": {
          "type": "boolean",
          "description": "Did user take medication"
        },
        "plans": {
          "type": "string",
          "description": "What user is doing today"
        },
        "passed": {
          "type": "boolean",
          "description": "Whether AI check passed"
        },
        "concerns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of AI-detected concerns"
        }
      },
      "description": "AI wellness check results"
    },
    "streak_day": {
      "type": "number",
      "default": 1,
      "description": "Current consecutive day streak"
    },
    "is_emergency": {
      "type": "boolean",
      "default": false,
      "description": "Marked as emergency check-in"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "photo",
        "video",
        "none"
      ],
      "default": "none",
      "description": "Type of media uploaded"
    },
    "media_url": {
      "type": "string",
      "description": "URL to uploaded photo or video"
    },
    "video_duration": {
      "type": "number",
      "description": "Video duration in seconds"
    },
    "ai_moderation": {
      "type": "object",
      "properties": {
        "approved": {
          "type": "boolean",
          "description": "Whether content passed AI moderation"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Any moderation flags"
        },
        "confidence": {
          "type": "number",
          "description": "AI confidence score 0-1"
        },
        "analysis": {
          "type": "string",
          "description": "AI analysis of the content"
        }
      },
      "description": "AI moderation results for media"
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has premium subscription"
    }
  },
  "required": [
    "user_email",
    "wallet_address",
    "wallet_type",
    "tx_hash",
    "amount"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user.role": "admin"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user.role": "admin"
        }
      ]
    }
  }
}