{
  "name": "AgentMessage",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "Unique conversation thread ID"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of message sender"
    },
    "sender_address": {
      "type": "string",
      "description": "Kaspa address of sender"
    },
    "sender_username": {
      "type": "string",
      "description": "Username of sender"
    },
    "sender_agent_id": {
      "type": "string",
      "description": "Agent ZK ID of sender"
    },
    "recipient_email": {
      "type": "string",
      "description": "Email of message recipient"
    },
    "recipient_address": {
      "type": "string",
      "description": "Kaspa address of recipient"
    },
    "recipient_username": {
      "type": "string",
      "description": "Username of recipient"
    },
    "recipient_agent_id": {
      "type": "string",
      "description": "Agent ZK ID of recipient"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "ai_enhanced": {
      "type": "boolean",
      "default": false,
      "description": "Whether message was AI-enhanced"
    },
    "original_message": {
      "type": "string",
      "description": "Original message before AI enhancement"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether recipient has read message"
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "When message was read"
    }
  },
  "required": [
    "conversation_id",
    "sender_email",
    "sender_address",
    "recipient_address",
    "message"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "sender_email": "{{user.email}}"
        },
        {
          "recipient_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "sender_email": "{{user.email}}"
        },
        {
          "recipient_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "sender_email": "{{user.email}}"
    }
  }
}