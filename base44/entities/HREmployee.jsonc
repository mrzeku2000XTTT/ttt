{
  "name": "HREmployee",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Employee email (linked to user)"
    },
    "wallet_address": {
      "type": "string",
      "description": "Kaspa wallet address"
    },
    "full_name": {
      "type": "string",
      "description": "Full name"
    },
    "agentzk_username": {
      "type": "string",
      "description": "Agent ZK profile username"
    },
    "resume_url": {
      "type": "string",
      "description": "Resume file URL"
    },
    "role": {
      "type": "string",
      "description": "Job title/role"
    },
    "department": {
      "type": "string",
      "description": "Department"
    },
    "salary_usd": {
      "type": "number",
      "description": "Monthly salary in USD"
    },
    "pto_balance_hours": {
      "type": "number",
      "default": 0,
      "description": "PTO balance in hours"
    },
    "pto_accrual_rate": {
      "type": "number",
      "default": 10,
      "description": "PTO hours earned per month"
    },
    "hire_date": {
      "type": "string",
      "format": "date",
      "description": "Date hired"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "on_leave",
        "terminated"
      ],
      "default": "active",
      "description": "Employment status"
    },
    "company_id": {
      "type": "string",
      "description": "Company owner email"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "user_email",
    "wallet_address",
    "full_name",
    "role",
    "salary_usd",
    "company_id"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "data.company_id": "{{user.email}}"
    },
    "delete": {
      "data.company_id": "{{user.email}}"
    }
  }
}