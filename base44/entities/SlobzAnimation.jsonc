{
  "name": "SlobzAnimation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Animation title"
    },
    "video_url": {
      "type": "string",
      "description": "Uploaded or generated video URL"
    },
    "creator_name": {
      "type": "string",
      "description": "Display name of the animator"
    },
    "wallet_address": {
      "type": "string",
      "description": "Creator's Kaspa wallet address for tips"
    },
    "tips_received": {
      "type": "number",
      "default": 0,
      "description": "Total KAS tips received"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "title",
    "video_url",
    "wallet_address"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}