{
  "name": "ZekuToken",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User identifier"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "Current token balance"
    },
    "total_earned": {
      "type": "number",
      "default": 0,
      "description": "Lifetime tokens earned"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "user_email": "{{user.email}}"
    },
    "read": {
      "user_email": "{{user.email}}"
    },
    "update": {
      "user_email": "{{user.email}}"
    },
    "delete": {
      "user_email": "{{user.email}}"
    }
  }
}