{
  "name": "Payment",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to company"
    },
    "employee_id": {
      "type": "string",
      "description": "Reference to employee"
    },
    "referral_id": {
      "type": "string",
      "description": "Reference to referral"
    },
    "amount": {
      "type": "number",
      "description": "Payment amount in USD"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "payroll",
        "paypal",
        "kaspa"
      ],
      "description": "Payment method"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "paid",
        "failed"
      ],
      "default": "pending",
      "description": "Payment status"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date-time",
      "description": "When payment should be processed"
    },
    "paid_date": {
      "type": "string",
      "format": "date-time",
      "description": "When payment was processed"
    },
    "transaction_id": {
      "type": "string",
      "description": "Kaspa transaction hash"
    },
    "notes": {
      "type": "string",
      "description": "Payment notes"
    }
  },
  "required": [
    "company_id",
    "employee_id",
    "referral_id",
    "amount",
    "payment_method"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}