{
  "name": "NFTVault",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User who owns this NFT vault"
    },
    "wallet_address": {
      "type": "string",
      "description": "User's primary wallet address"
    },
    "nft_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of NFT IDs stored in this vault"
    },
    "total_nfts": {
      "type": "number",
      "default": 0,
      "description": "Total number of NFTs in vault"
    },
    "total_value_zeku": {
      "type": "number",
      "default": 0,
      "description": "Total value in ZEKU"
    },
    "is_locked": {
      "type": "boolean",
      "default": true,
      "description": "Whether vault is locked with PIN"
    },
    "pin_hash": {
      "type": "string",
      "description": "Hashed PIN for vault access"
    },
    "last_unlocked": {
      "type": "string",
      "format": "date-time",
      "description": "Last time vault was unlocked"
    },
    "unlock_attempts": {
      "type": "number",
      "default": 0,
      "description": "Failed unlock attempts"
    },
    "vault_created": {
      "type": "string",
      "format": "date-time",
      "description": "When vault was created"
    }
  },
  "required": [
    "user_email",
    "wallet_address"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  },
  "type": "object"
}