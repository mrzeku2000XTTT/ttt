{
  "name": "TherapySession",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User's email"
    },
    "session_title": {
      "type": "string",
      "description": "Auto-generated session title"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      },
      "description": "Conversation messages"
    },
    "emotional_state": {
      "type": "string",
      "description": "Detected emotional state"
    },
    "key_topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Main topics discussed"
    },
    "insights_generated": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "AI-generated insights"
    },
    "progress_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Mental wellness progress score"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "user_email": "{{user.email}}"
    },
    "read": {
      "user_email": "{{user.email}}"
    },
    "update": {
      "user_email": "{{user.email}}"
    },
    "delete": {
      "user_email": "{{user.email}}"
    }
  }
}