{
  "name": "ContinuityAnchor",
  "type": "object",
  "properties": {
    "vector": {
      "type": "string",
      "description": "Directional aim - what the user was trying to bring into existence"
    },
    "weight": {
      "type": "string",
      "description": "Contextual significance - why this mattered at this moment"
    },
    "open_loop": {
      "type": "string",
      "description": "Point of suspension - the specific unresolved question or next action"
    },
    "pressure": {
      "type": "string",
      "enum": [
        "creative_flow",
        "urgent_solving",
        "analytical_thinking",
        "routine_execution"
      ],
      "description": "Motivational quality - the nature of engagement"
    },
    "kaspa_tx_hash": {
      "type": "string",
      "description": "Kaspa transaction hash for verification"
    },
    "block_height": {
      "type": "number",
      "description": "Kaspa block height (blue score) at which the anchor tx was accepted"
    },
    "anchor_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the anchor was created"
    },
    "context_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for categorizing the work context"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether Kaspa verification succeeded"
    },
    "project_id": {
      "type": "string",
      "description": "TTT Builder project this anchor belongs to"
    },
    "manifest_hash": {
      "type": "string",
      "description": "Deterministic sha256 of the project file manifest at anchor time (Builder extension)"
    },
    "content_hash": {
      "type": "string",
      "description": "sha256 of the canonicalized anchor payload - the value proven by the Kaspa tx (Builder extension)"
    },
    "git_ref": {
      "type": "string",
      "description": "Git commit SHA at anchor time, or null"
    },
    "deployment_ref": {
      "type": "string",
      "description": "Live deployment URL at anchor time, or null"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "intent",
        "milestone",
        "open_loop",
        "commit",
        "deployment",
        "kaspa_action",
        "session_end",
        "divergence_resolution",
        "manual"
      ],
      "description": "What meaningful event created this anchor (Builder extension)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "vector",
    "weight",
    "open_loop",
    "pressure"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}