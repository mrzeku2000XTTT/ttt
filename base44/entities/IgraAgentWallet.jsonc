{
  "name": "IgraAgentWallet",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Agent identifier: alpha or beta"
    },
    "address": {
      "type": "string",
      "description": "EVM address on Igra mainnet (chain 38833)"
    },
    "private_key": {
      "type": "string",
      "description": "Agent wallet private key (admin-only, used server-side to sign iKAS transactions)"
    }
  },
  "required": [
    "name",
    "address",
    "private_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}