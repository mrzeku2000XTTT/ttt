{
  "name": "SSHConnection",
  "type": "object",
  "properties": {
    "project_name": {
      "type": "string",
      "description": "Name of the project"
    },
    "host": {
      "type": "string",
      "description": "SSH host address"
    },
    "port": {
      "type": "number",
      "default": 22,
      "description": "SSH port"
    },
    "username": {
      "type": "string",
      "description": "SSH username"
    },
    "password": {
      "type": "string",
      "description": "SSH password (encrypted)"
    },
    "private_key": {
      "type": "string",
      "description": "Private SSH key (encrypted)"
    },
    "connection_type": {
      "type": "string",
      "enum": [
        "password",
        "key"
      ],
      "default": "password",
      "description": "Authentication method"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "testing"
      ],
      "default": "disconnected",
      "description": "Connection status"
    },
    "last_connected": {
      "type": "string",
      "format": "date-time",
      "description": "Last successful connection"
    },
    "project_path": {
      "type": "string",
      "description": "Path to project on remote server"
    },
    "description": {
      "type": "string",
      "description": "Project description"
    }
  },
  "required": [
    "project_name",
    "host",
    "username"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user.role": "admin"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user.role": "admin"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user.role": "admin"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user.role": "admin"
        }
      ]
    }
  }
}