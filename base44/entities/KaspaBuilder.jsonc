{
  "name": "KaspaBuilder",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "TTT username"
    },
    "kaspa_address": {
      "type": "string",
      "description": "Kaspa wallet address from TTT"
    },
    "twitter_handle": {
      "type": "string",
      "description": "Twitter handle"
    },
    "avatar": {
      "type": "string",
      "description": "Profile photo URL"
    },
    "cover_photo": {
      "type": "string",
      "description": "Cover background photo URL (KNS badge)"
    },
    "kns_id": {
      "type": "string",
      "description": "KNS ID if they have one"
    },
    "kns_photo": {
      "type": "string",
      "description": "Photo of KNS ID card/badge"
    },
    "app_url": {
      "type": "string",
      "description": "URL to developer's app or project"
    },
    "description": {
      "type": "string",
      "description": "Why they need funds and what they're building"
    },
    "funding_goal": {
      "type": "number",
      "description": "Funding goal in KAS"
    },
    "how_funds_used": {
      "type": "string",
      "description": "Detailed explanation of how funds will be used"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Verified dev status"
    },
    "votes": {
      "type": "number",
      "default": 0,
      "description": "Vote count"
    },
    "total_tips": {
      "type": "number",
      "default": 0,
      "description": "Total KAS tips received"
    }
  },
  "required": [
    "username",
    "kaspa_address"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}