{
  "name": "RecipientProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Who created this profile"
    },
    "recipient_name": {
      "type": "string",
      "description": "Name of the recipient"
    },
    "relationship": {
      "type": "string",
      "enum": [
        "Partner",
        "Friend",
        "Family",
        "Colleague",
        "Other"
      ],
      "description": "Relationship to recipient"
    },
    "age_group": {
      "type": "string",
      "enum": [
        "Child",
        "Teen",
        "Young Adult",
        "Adult",
        "Senior"
      ],
      "description": "Age group"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of interests"
    },
    "favorite_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Preferred product categories"
    },
    "budget_range": {
      "type": "string",
      "description": "Budget range for gifts"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "user_email",
    "recipient_name"
  ],
  "rls": {
    "create": {
      "user_email": "{{user.email}}"
    },
    "read": {
      "user_email": "{{user.email}}"
    },
    "update": {
      "user_email": "{{user.email}}"
    },
    "delete": {
      "user_email": "{{user.email}}"
    }
  }
}