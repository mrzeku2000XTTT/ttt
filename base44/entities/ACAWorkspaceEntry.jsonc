{
  "name": "ACAWorkspaceEntry",
  "type": "object",
  "properties": {
    "computer_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "FILE",
        "DIRECTORY"
      ]
    },
    "revision_id": {
      "type": "string"
    },
    "deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "computer_id",
    "agent_id",
    "path",
    "kind"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}