{
  "name": "DAGDonationWallet",
  "type": "object",
  "properties": {
    "kaspa_address": {
      "type": "string",
      "description": "Public Kaspa donation address"
    },
    "seed_phrase": {
      "type": "string",
      "description": "Encrypted seed phrase (admin-only)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When wallet was created"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is the active donation wallet"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "kaspa_address",
    "seed_phrase"
  ],
  "rls": {
    "create": {
      "user.role": "admin"
    },
    "read": true,
    "update": {
      "user.role": "admin"
    },
    "delete": {
      "user.role": "admin"
    }
  }
}