{
  "name": "UserLocation",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User identifier"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude coordinate"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude coordinate"
    },
    "city": {
      "type": "string",
      "description": "City name"
    },
    "country": {
      "type": "string",
      "description": "Country name"
    },
    "encrypted_location": {
      "type": "string",
      "description": "Encrypted location data for Agent ZK"
    },
    "share_with_app": {
      "type": "boolean",
      "default": false,
      "description": "Whether to share location with other app features"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Last location update timestamp"
    },
    "accuracy": {
      "type": "number",
      "description": "GPS accuracy in meters"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "user_email",
    "latitude",
    "longitude"
  ],
  "rls": {
    "create": null,
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}