{
  "name": "BullMoonAlert",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User's email for notifications"
    },
    "phone_number": {
      "type": "string",
      "description": "User's phone for SMS alerts"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether alerts are enabled"
    },
    "days_before": {
      "type": "number",
      "default": 1,
      "description": "Days before eclipse to send alert"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": true,
    "read": {
      "user_email": "{{user.email}}"
    },
    "update": {
      "user_email": "{{user.email}}"
    },
    "delete": {
      "user_email": "{{user.email}}"
    }
  }
}