{
  "name": "PostExplanationQuery",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User who requested explanation"
    },
    "post_id": {
      "type": "string",
      "description": "Post that was explained"
    },
    "query_date": {
      "type": "string",
      "format": "date",
      "description": "Date of query (for daily limit tracking)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "user_email",
    "post_id",
    "query_date"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": false,
    "delete": false
  }
}