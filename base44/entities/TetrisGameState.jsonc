{
  "name": "TetrisGameState",
  "type": "object",
  "properties": {
    "match_id": {
      "type": "string",
      "description": "Reference to match"
    },
    "user_email": {
      "type": "string",
      "description": "Player's email"
    },
    "board": {
      "type": "array",
      "items": {
        "type": "array"
      },
      "description": "Current board state"
    },
    "current_piece": {
      "type": "object",
      "description": "Current falling piece"
    },
    "next_pieces": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Next pieces queue"
    },
    "held_piece": {
      "type": "object",
      "description": "Held piece"
    },
    "score": {
      "type": "number",
      "default": 0,
      "description": "Current score"
    },
    "lines_cleared": {
      "type": "number",
      "default": 0,
      "description": "Lines cleared"
    },
    "level": {
      "type": "number",
      "default": 1,
      "description": "Current level"
    },
    "garbage_queue": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Incoming garbage lines"
    },
    "combo": {
      "type": "number",
      "default": 0,
      "description": "Current combo count"
    },
    "game_over": {
      "type": "boolean",
      "default": false,
      "description": "Is game over"
    },
    "last_action": {
      "type": "string",
      "format": "date-time",
      "description": "Last action timestamp"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "match_id",
    "user_email"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": null
  }
}