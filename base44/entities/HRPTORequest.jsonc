{
  "name": "HRPTORequest",
  "type": "object",
  "properties": {
    "employee_email": {
      "type": "string",
      "description": "Employee requesting PTO"
    },
    "employee_name": {
      "type": "string",
      "description": "Employee name"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "PTO start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "PTO end date"
    },
    "total_days": {
      "type": "number",
      "description": "Number of days requested"
    },
    "total_hours": {
      "type": "number",
      "description": "Number of hours requested"
    },
    "reason": {
      "type": "string",
      "description": "Reason for PTO"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "denied"
      ],
      "default": "pending",
      "description": "Request status"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Who approved/denied"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When reviewed"
    },
    "company_id": {
      "type": "string",
      "description": "Company owner email"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "employee_email",
    "employee_name",
    "start_date",
    "end_date",
    "total_hours",
    "reason",
    "company_id"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "company_id": "{{user.email}}"
    }
  }
}