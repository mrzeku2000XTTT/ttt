{
  "name": "GiftCart",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Cart owner"
    },
    "cart_name": {
      "type": "string",
      "description": "Name of the cart"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "wishlist_item_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "product_url": {
            "type": "string"
          },
          "price_usd": {
            "type": "number"
          },
          "price_kas": {
            "type": "number"
          }
        }
      },
      "description": "Items in this cart"
    },
    "total_usd": {
      "type": "number",
      "default": 0,
      "description": "Total cart value in USD"
    },
    "total_kas": {
      "type": "number",
      "default": 0,
      "description": "Total cart value in KAS"
    },
    "is_shared": {
      "type": "boolean",
      "default": false,
      "description": "Whether cart is publicly shared"
    },
    "share_code": {
      "type": "string",
      "description": "Unique code for sharing"
    },
    "owner_name": {
      "type": "string",
      "description": "Display name of cart owner"
    },
    "occasion": {
      "type": "string",
      "description": "Birthday, Anniversary, Christmas, etc."
    },
    "occasion_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the occasion"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "user_email",
    "cart_name"
  ],
  "rls": {
    "create": {
      "user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "is_shared": true
        }
      ]
    },
    "update": {
      "user_email": "{{user.email}}"
    },
    "delete": {
      "user_email": "{{user.email}}"
    }
  }
}