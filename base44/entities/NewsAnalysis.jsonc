{
  "name": "NewsAnalysis",
  "type": "object",
  "properties": {
    "news_id": {
      "type": "string",
      "description": "Reference to StampedNews ID"
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "very_negative",
        "negative",
        "neutral",
        "positive",
        "very_positive"
      ],
      "description": "Overall sentiment"
    },
    "key_topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Main topics extracted"
    },
    "entities_mentioned": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Countries, leaders, organizations"
    },
    "severity_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "War severity 0-10"
    },
    "predicted_impact": {
      "type": "string",
      "description": "Predicted geopolitical impact"
    },
    "similar_events": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Historical similar events"
    },
    "ai_summary": {
      "type": "string",
      "description": "AI-generated summary"
    },
    "credibility_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Source credibility 0-10"
    },
    "escalation_risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "Risk of conflict escalation"
    },
    "civilian_impact": {
      "type": "string",
      "enum": [
        "minimal",
        "moderate",
        "significant",
        "catastrophic"
      ],
      "description": "Impact on civilians"
    },
    "analyzed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When analysis was done"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "news_id",
    "sentiment",
    "severity_score"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user.role": "admin"
        }
      ]
    },
    "read": true,
    "update": {
      "user.role": "admin"
    },
    "delete": {
      "user.role": "admin"
    }
  }
}