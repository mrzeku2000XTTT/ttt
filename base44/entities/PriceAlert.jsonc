{
  "name": "PriceAlert",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User who set the alert"
    },
    "wishlist_item_id": {
      "type": "string",
      "description": "Reference to wishlist item"
    },
    "target_price_usd": {
      "type": "number",
      "description": "Alert when price drops below this"
    },
    "current_price_usd": {
      "type": "number",
      "description": "Last checked price"
    },
    "is_triggered": {
      "type": "boolean",
      "default": false,
      "description": "Whether alert has been triggered"
    },
    "last_checked": {
      "type": "string",
      "format": "date-time",
      "description": "Last price check"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "user_email",
    "wishlist_item_id",
    "target_price_usd"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}