{
  "name": "SealedWallet",
  "type": "object",
  "properties": {
    "wallet_address": {
      "type": "string",
      "description": "Kaspa wallet address being sealed"
    },
    "seal_signature": {
      "type": "string",
      "description": "Kasware signature proving ownership"
    },
    "seal_message": {
      "type": "string",
      "description": "Message that was signed"
    },
    "sealed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the wallet was sealed"
    },
    "balance_at_seal": {
      "type": "number",
      "description": "Balance in KAS at time of sealing"
    },
    "mnemonic_word_count": {
      "type": "number",
      "description": "Number of words in seed phrase (12 or 24)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this seal is active"
    },
    "parent_kasware_address": {
      "type": "string",
      "description": "Kasware L1 address that stamped this wallet (parent verification)"
    },
    "parent_stamp_signature": {
      "type": "string",
      "description": "Kasware signature from parent address proving 2FA ownership"
    },
    "parent_stamp_message": {
      "type": "string",
      "description": "Message signed by parent Kasware address"
    },
    "stamped_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this wallet was stamped by parent Kasware"
    },
    "is_stamped": {
      "type": "boolean",
      "default": false,
      "description": "Whether this wallet has been stamped with parent verification"
    }
  },
  "required": [
    "wallet_address",
    "seal_signature",
    "sealed_date"
  ]
}