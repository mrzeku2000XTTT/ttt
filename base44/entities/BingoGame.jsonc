{
  "name": "BingoGame",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "Unique game identifier"
    },
    "game_type": {
      "type": "string",
      "enum": [
        "single",
        "lobby"
      ],
      "default": "single",
      "description": "Single player or multi-player lobby"
    },
    "game_code": {
      "type": "string",
      "description": "6-character lobby code (for lobby games)"
    },
    "total_cards": {
      "type": "number",
      "description": "Total cards in lobby (1-30)"
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cardNumber": {
            "type": "number"
          },
          "numbers": {
            "type": "object"
          },
          "claimed": {
            "type": "boolean"
          },
          "claimedBy": {
            "type": "string"
          },
          "claimedByEmail": {
            "type": "string"
          }
        }
      },
      "description": "Available cards in lobby"
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "cardNumber": {
            "type": "number"
          },
          "joinedAt": {
            "type": "string"
          }
        }
      },
      "description": "Players in lobby"
    },
    "game_master": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "call_interval": {
          "type": "number"
        },
        "ball_display_time": {
          "type": "number"
        },
        "status": {
          "type": "string"
        },
        "shuffled_pool": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "letter": {
                "type": "string"
              },
              "number": {
                "type": "number"
              },
              "id": {
                "type": "string"
              }
            }
          },
          "description": "Pre-shuffled pool of all 75 numbers (provably fair)"
        },
        "pool_hash": {
          "type": "string",
          "description": "SHA-256 hash of original shuffled pool for verification"
        },
        "called_numbers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "letter": {
                "type": "string"
              },
              "number": {
                "type": "number"
              },
              "id": {
                "type": "string"
              },
              "called_at": {
                "type": "string"
              },
              "call_number": {
                "type": "number"
              }
            }
          },
          "description": "Numbers that have been called"
        },
        "current_call": {
          "type": "object",
          "properties": {
            "letter": {
              "type": "string"
            },
            "number": {
              "type": "number"
            },
            "id": {
              "type": "string"
            },
            "called_at": {
              "type": "string"
            },
            "call_number": {
              "type": "number"
            }
          },
          "description": "Current number being displayed"
        },
        "call_history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "letter": {
                "type": "string"
              },
              "number": {
                "type": "number"
              },
              "id": {
                "type": "string"
              },
              "called_at": {
                "type": "string"
              },
              "call_number": {
                "type": "number"
              }
            }
          },
          "description": "Last 10 calls for display"
        },
        "next_call_time": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        }
      },
      "description": "AI Game Master state"
    },
    "encrypted_seed_phrase": {
      "type": "string",
      "description": "Encrypted 24-word seed phrase with funds"
    },
    "wallet_address": {
      "type": "string",
      "description": "Kaspa address of the bingo wallet"
    },
    "prize_amount": {
      "type": "number",
      "description": "Amount of KAS in the wallet"
    },
    "bingo_numbers": {
      "type": "object",
      "properties": {
        "B": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "I": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "N": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "G": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "O": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "description": "Provably fair BINGO numbers for 5x5 card (single player games)"
    },
    "server_seed_hash": {
      "type": "string",
      "description": "SHA-256 hash of server seed (for provably fair verification)"
    },
    "client_seed": {
      "type": "string",
      "description": "Client seed for random generation"
    },
    "card_hash": {
      "type": "string",
      "description": "Hash of complete card mapping"
    },
    "revealed_words": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "word_index": {
            "type": "number"
          },
          "word": {
            "type": "string"
          },
          "revealed_by": {
            "type": "string"
          },
          "revealed_at": {
            "type": "string",
            "format": "date-time"
          },
          "card_number": {
            "type": "number"
          }
        }
      },
      "description": "Track who revealed each word"
    },
    "winner_email": {
      "type": "string",
      "description": "Email of winner who revealed all 24"
    },
    "winner_address": {
      "type": "string",
      "description": "Wallet address of winner"
    },
    "winner_card_number": {
      "type": "number",
      "description": "Card number of winning player (for lobby games)"
    },
    "won_at": {
      "type": "string",
      "format": "date-time",
      "description": "When game was won"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "active",
        "completed",
        "expired"
      ],
      "default": "active",
      "description": "Game status"
    },
    "created_by_admin": {
      "type": "string",
      "description": "Admin who created this game"
    }
  },
  "required": [
    "game_id",
    "encrypted_seed_phrase",
    "wallet_address",
    "prize_amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user.role": "admin"
        },
        {
          "user.agent_zk_id": {
            "$exists": true
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user.role": "admin"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user.role": "admin"
        }
      ]
    }
  }
}