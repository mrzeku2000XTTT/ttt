{
  "name": "ThumbnailProject",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Thumbnail title or video title"
    },
    "topic": {
      "type": "string",
      "description": "Topic or prompt used to create the thumbnail"
    },
    "character_description": {
      "type": "string",
      "description": "Face, avatar, or character description used in the thumbnail"
    },
    "style": {
      "type": "string",
      "description": "Selected thumbnail style"
    },
    "platform": {
      "type": "string",
      "default": "YouTube",
      "description": "Target platform for the thumbnail"
    },
    "image_url": {
      "type": "string",
      "description": "Generated thumbnail image URL"
    },
    "prompt": {
      "type": "string",
      "description": "Full image generation prompt"
    },
    "youtube_url": {
      "type": "string",
      "description": "YouTube or web URL used as source research"
    },
    "source_image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Uploaded reference images used for the thumbnail"
    },
    "script_text": {
      "type": "string",
      "description": "Video script, notes, or transcript pasted by the user"
    },
    "research_notes": {
      "type": "string",
      "description": "Online research and fact-check notes created by the thumbnail agent"
    },
    "agent_plan": {
      "type": "string",
      "description": "Agentic thumbnail strategy and composition plan"
    },
    "fact_checks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key verified facts or warnings used during generation"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "title",
    "topic",
    "image_url"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}