{
  "name": "EvolveGeoOwnership",
  "type": "object",
  "properties": {
    "experiment_id": {
      "type": "string",
      "description": "EVOLVE experiment this ownership belongs to"
    },
    "cell_id": {
      "type": "string",
      "description": "Geographic cell id G{lat*1e6}_{lng*1e6} from geoCells. Deterministic from lat/lng."
    },
    "owner_type": {
      "type": "string",
      "enum": [
        "AI",
        "HUMAN",
        "ORGANIZATION"
      ]
    },
    "owner_id": {
      "type": "string",
      "description": "Stable actor key: agent_key (AGT_0134), player_key (PLR_0001), or org_key. Never the DB record id."
    },
    "owner_code": {
      "type": "string",
      "description": "Display code for rendering (A#134, P#001, org name). Denormalized for display only."
    },
    "organization_id": {
      "type": "string",
      "description": "Org id if the owner belongs to an organization. Empty for independent actors."
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "claim_source": {
      "type": "string",
      "enum": [
        "SPAWN",
        "CLAIM",
        "BUILD",
        "ECONOMIC_EXPANSION"
      ],
      "default": "SPAWN"
    },
    "claim_id": {
      "type": "string",
      "description": "EvolveTerritoryClaim record id when this cell was acquired through an economic expansion. Empty for SPAWN/CLAIM."
    },
    "claim_tx_id": {
      "type": "string",
      "description": "TN-10 txid of the verified settlement that acquired this cell"
    },
    "claim_amount_sompi": {
      "type": "number",
      "default": 0,
      "description": "Verified settlement amount for this cell, in sompi"
    },
    "current_ownership_event_id": {
      "type": "string",
      "description": "EvolveGeoOwnershipEvent that produced the CURRENT control of this cell. This record is present-state only; the event ledger is the history."
    },
    "center_lat": {
      "type": "number",
      "description": "Geographic center latitude of the owned cell"
    },
    "center_lng": {
      "type": "number",
      "description": "Geographic center longitude of the owned cell"
    }
  },
  "required": [
    "experiment_id",
    "cell_id",
    "owner_type",
    "owner_id"
  ],
  "rls": {
    "read": null,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}