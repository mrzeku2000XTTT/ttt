{
  "name": "Slide",
  "type": "object",
  "properties": {
    "deck_id": {
      "type": "string",
      "description": "Parent SlideDeck id"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Slide order within the deck"
    },
    "prompt": {
      "type": "string",
      "description": "Visual prompt for the slide"
    },
    "voiceover": {
      "type": "string",
      "description": "Narrator voiceover text"
    },
    "duration": {
      "type": "number",
      "default": 5,
      "description": "Duration in seconds"
    },
    "style": {
      "type": "string",
      "enum": [
        "kaspa",
        "fire",
        "neon",
        "luxury",
        "minimal",
        "ocean",
        "dark",
        "auto"
      ],
      "default": "auto",
      "description": "Per-slide style override"
    },
    "image_url": {
      "type": "string",
      "description": "Rendered still image URL"
    },
    "slide_video_url": {
      "type": "string",
      "description": "Rendered per-slide video URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "rendering",
        "done",
        "error"
      ],
      "default": "pending",
      "description": "Per-slide render status"
    },
    "error": {
      "type": "string",
      "description": "Error message if failed"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "deck_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}