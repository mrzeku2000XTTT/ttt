{
  "name": "AgentYingVision",
  "type": "object",
  "properties": {
    "vision_id": {
      "type": "string",
      "description": "Unique vision analysis ID"
    },
    "verification_id": {
      "type": "string",
      "description": "Reference to parent verification"
    },
    "image_url": {
      "type": "string",
      "description": "URL to analyzed image"
    },
    "extracted_text": {
      "type": "string",
      "description": "All text found in image (OCR)"
    },
    "detected_objects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Objects/elements detected in image"
    },
    "detected_usernames": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Social media usernames found"
    },
    "detected_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs found in image"
    },
    "detected_numbers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Numbers/IDs found in image"
    },
    "visual_summary": {
      "type": "string",
      "description": "AI description of what's in the image"
    },
    "proof_indicators": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Visual indicators of task completion"
    },
    "confidence": {
      "type": "number",
      "description": "Vision analysis confidence (0-1)"
    },
    "task_type": {
      "type": "string",
      "description": "Detected task type from visual analysis"
    },
    "analyzed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When image was analyzed"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "vision_id",
    "image_url",
    "visual_summary"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": false,
    "delete": {
      "user.role": "admin"
    }
  }
}