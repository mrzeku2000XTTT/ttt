{
  "name": "HRExpense",
  "type": "object",
  "properties": {
    "employee_email": {
      "type": "string",
      "description": "Employee submitting expense"
    },
    "employee_name": {
      "type": "string",
      "description": "Employee name"
    },
    "description": {
      "type": "string",
      "description": "Expense description"
    },
    "amount_usd": {
      "type": "number",
      "description": "Amount in USD"
    },
    "category": {
      "type": "string",
      "enum": [
        "travel",
        "meals",
        "office_supplies",
        "software",
        "training",
        "other"
      ],
      "description": "Expense category"
    },
    "receipt_url": {
      "type": "string",
      "description": "Receipt image URL"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Expense date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "denied",
        "reimbursed"
      ],
      "default": "pending",
      "description": "Expense status"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Who approved/denied"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When reviewed"
    },
    "company_id": {
      "type": "string",
      "description": "Company owner email"
    }
  },
  "required": [
    "employee_email",
    "employee_name",
    "description",
    "amount_usd",
    "category",
    "date",
    "company_id"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "company_id": "{{user.email}}"
    }
  }
}