{
  "name": "LearningModule",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Module title"
    },
    "category": {
      "type": "string",
      "description": "Learning category"
    },
    "lesson_content": {
      "type": "string",
      "description": "Teaching content"
    },
    "quiz_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_answer": {
            "type": "number"
          }
        }
      },
      "description": "Quiz questions"
    },
    "reward_tokens": {
      "type": "number",
      "default": 10,
      "description": "Tokens awarded"
    },
    "icon": {
      "type": "string",
      "description": "Icon emoji"
    },
    "order": {
      "type": "number",
      "description": "Display order"
    }
  },
  "required": [
    "title",
    "category",
    "lesson_content",
    "quiz_questions",
    "reward_tokens"
  ]
}