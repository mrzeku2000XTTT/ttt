{
  "name": "TTTAppRegistry",
  "type": "object",
  "properties": {
    "app_name": {
      "type": "string",
      "description": "Display name of the app"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe slug for the app (e.g. 'my-cool-app')"
    },
    "path": {
      "type": "string",
      "description": "Internal route path (e.g. 'Feed', 'AgentZK')"
    },
    "external_url": {
      "type": "string",
      "description": "External URL if app is external (e.g. E2B live URL)"
    },
    "category": {
      "type": "string",
      "description": "App category (AI, Finance, Games, Tools, etc.)"
    },
    "description": {
      "type": "string",
      "description": "Short description of what the app does"
    },
    "logo_url": {
      "type": "string",
      "description": "App icon URL"
    },
    "submitter_email": {
      "type": "string",
      "description": "Email of the user who published this app"
    },
    "submitter_name": {
      "type": "string",
      "description": "Display name of the publisher"
    },
    "e2b_sandbox_id": {
      "type": "string",
      "description": "E2B sandbox ID for the live instance"
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "description": "Premium-only app"
    },
    "is_admin_only": {
      "type": "boolean",
      "default": false,
      "description": "Admin-only app"
    },
    "agent_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Actions a TTT 3.0 agent can perform inside this app"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the app is live in the registry"
    }
  },
  "required": [
    "app_name",
    "category"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "data.submitter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.submitter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}