{
  "name": "AgentZKProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User's email"
    },
    "username": {
      "type": "string",
      "description": "Display name"
    },
    "wallet_address": {
      "type": "string",
      "description": "Kasware L1 wallet address"
    },
    "ttt_wallet_address": {
      "type": "string",
      "description": "TTT wallet address"
    },
    "metamask_address": {
      "type": "string",
      "description": "MetaMask L2 address"
    },
    "agent_zk_id": {
      "type": "string",
      "description": "Unique Agent ZK ID"
    },
    "agent_zk_photo": {
      "type": "string",
      "description": "Profile photo URL"
    },
    "cover_photo": {
      "type": "string",
      "description": "Cover photo URL"
    },
    "bio": {
      "type": "string",
      "description": "Biography"
    },
    "role": {
      "type": "string",
      "description": "Professional role"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of skills"
    },
    "tech_background": {
      "type": "string",
      "description": "Technical background"
    },
    "hourly_rate_kas": {
      "type": "number",
      "description": "Hourly rate in KAS"
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "busy",
        "offline"
      ],
      "default": "available",
      "description": "Current availability"
    },
    "work_type": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Worker or employer"
    },
    "is_hireable": {
      "type": "boolean",
      "default": false,
      "description": "Open to job offers"
    },
    "verification_count": {
      "type": "number",
      "default": 0,
      "description": "Number of verifications"
    },
    "kns_domain": {
      "type": "string",
      "description": "KNS domain name"
    },
    "social_links": {
      "type": "object",
      "properties": {
        "twitter": {
          "type": "string"
        },
        "github": {
          "type": "string"
        },
        "discord": {
          "type": "string"
        },
        "reddit": {
          "type": "string"
        },
        "website": {
          "type": "string"
        }
      },
      "description": "Social media links"
    },
    "id_card_generated": {
      "type": "boolean",
      "default": false,
      "description": "Whether ID card was generated"
    },
    "last_active": {
      "type": "string",
      "format": "date-time",
      "description": "Last time user was active"
    }
  },
  "required": [
    "user_email",
    "username",
    "wallet_address",
    "agent_zk_id"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}