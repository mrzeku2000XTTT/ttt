{
  "name": "KaiTranscript",
  "type": "object",
  "properties": {
    "video_id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "transcript": {
      "type": "string"
    },
    "word_count": {
      "type": "number"
    },
    "chunk_count": {
      "type": "number"
    },
    "language": {
      "type": "string"
    },
    "is_generated": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "failed"
      ]
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": []
}