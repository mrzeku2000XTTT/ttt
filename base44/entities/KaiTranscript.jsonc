{
  "name": "KaiTranscript",
  "type": "object",
  "properties": {
    "video_id": {
      "type": "string",
      "description": "YouTube video ID or web_ prefixed ID for scraped pages"
    },
    "url": {
      "type": "string",
      "description": "Original URL"
    },
    "title": {
      "type": "string",
      "description": "Video or page title"
    },
    "transcript": {
      "type": "string",
      "description": "Full transcript or scraped text content"
    },
    "word_count": {
      "type": "number",
      "description": "Word count of transcript"
    },
    "chunk_count": {
      "type": "number",
      "description": "Number of knowledge chunks"
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Pre-chunked text blocks for knowledge storage"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "failed"
      ],
      "default": "pending",
      "description": "Processing status"
    },
    "language": {
      "type": "string",
      "default": "en",
      "description": "Language code of transcript"
    },
    "is_generated": {
      "type": "boolean",
      "default": false,
      "description": "Whether transcript was auto-generated by YouTube"
    },
    "duration": {
      "type": "number",
      "description": "Video duration in seconds"
    },
    "description": {
      "type": "string",
      "description": "Video description"
    }
  },
  "required": [
    "video_id",
    "url",
    "status"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}