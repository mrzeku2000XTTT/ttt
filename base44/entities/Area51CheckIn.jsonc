{
  "name": "Area51CheckIn",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of user checking in"
    },
    "username": {
      "type": "string",
      "description": "Username"
    },
    "wallet_address": {
      "type": "string",
      "description": "Kasware wallet address"
    },
    "signature": {
      "type": "string",
      "description": "Kasware signature or biometric proof"
    },
    "check_in_message": {
      "type": "string",
      "description": "Message that was signed"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "kasware",
        "ios_faceid",
        "android"
      ],
      "description": "Type of authentication used"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "user_email",
    "username"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}