{
  "name": "KivRTransaction",
  "type": "object",
  "properties": {
    "phone_number": {
      "type": "string",
      "description": "Phone number linked to this transaction set"
    },
    "pin_hash": {
      "type": "string",
      "description": "Hashed PIN for IVR authentication"
    },
    "from_address": {
      "type": "string",
      "description": "Sender Kaspa address"
    },
    "to_address": {
      "type": "string",
      "description": "Recipient Kaspa address"
    },
    "amount": {
      "type": "number",
      "description": "Amount of KAS to send"
    },
    "label": {
      "type": "string",
      "description": "User-defined label for this preset (e.g. 'Pay Merchant A')"
    },
    "slot_number": {
      "type": "number",
      "description": "IVR slot (1-9) user presses to trigger this transaction"
    },
    "signed_tx_hex": {
      "type": "string",
      "description": "Pre-signed transaction hex ready for broadcast"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "used",
        "expired",
        "cancelled"
      ],
      "default": "active",
      "description": "Current status of this pre-signed transaction"
    },
    "broadcast_tx_id": {
      "type": "string",
      "description": "Transaction ID after broadcast"
    },
    "broadcast_at": {
      "type": "string",
      "format": "date-time",
      "description": "When it was broadcast"
    },
    "uses_remaining": {
      "type": "number",
      "default": 1,
      "description": "How many times this can be used (-1 = unlimited)"
    }
  },
  "required": [
    "phone_number",
    "from_address",
    "to_address",
    "amount"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}