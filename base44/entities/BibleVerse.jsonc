{
  "name": "BibleVerse",
  "type": "object",
  "properties": {
    "book": {
      "type": "string",
      "description": "Book name (e.g., John, Genesis)"
    },
    "chapter": {
      "type": "number",
      "description": "Chapter number"
    },
    "verse": {
      "type": "string",
      "description": "Verse numbers (e.g., '16' or '16-17')"
    },
    "text": {
      "type": "string",
      "description": "The verse text"
    },
    "reflection": {
      "type": "string",
      "description": "User's personal reflection or note"
    },
    "author_name": {
      "type": "string",
      "description": "Display name of who shared it"
    },
    "author_wallet_address": {
      "type": "string",
      "description": "User's wallet address"
    },
    "likes": {
      "type": "number",
      "default": 0,
      "description": "Number of likes"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false,
      "description": "Marked as favorite"
    }
  },
  "required": [
    "book",
    "chapter",
    "verse",
    "text",
    "author_name"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}