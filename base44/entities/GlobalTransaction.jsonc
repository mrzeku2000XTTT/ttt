{
  "name": "GlobalTransaction",
  "type": "object",
  "properties": {
    "tx_hash": {
      "type": "string",
      "description": "Transaction hash from blockchain"
    },
    "from_address": {
      "type": "string",
      "description": "Sender's address (truncated for privacy)"
    },
    "to_address": {
      "type": "string",
      "description": "Recipient's address (truncated)"
    },
    "amount": {
      "type": "number",
      "description": "Amount transferred"
    },
    "fee": {
      "type": "number",
      "description": "Transaction fee"
    },
    "network": {
      "type": "string",
      "enum": [
        "L1",
        "L2"
      ],
      "description": "Which layer the transaction occurred on"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the transaction occurred"
    },
    "is_public": {
      "type": "boolean",
      "default": true,
      "description": "Whether this transaction is shared publicly"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "tx_hash",
    "amount",
    "network",
    "timestamp"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "is_public": true
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}