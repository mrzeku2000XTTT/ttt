{
  "name": "DAGTip",
  "type": "object",
  "properties": {
    "from_address": {
      "type": "string",
      "description": "Sender's wallet address"
    },
    "to_address": {
      "type": "string",
      "description": "Recipient's wallet address"
    },
    "amount": {
      "type": "number",
      "description": "Tip amount in KAS"
    },
    "tx_hash": {
      "type": "string",
      "description": "Transaction hash"
    },
    "post_id": {
      "type": "string",
      "description": "DAG Post ID that was tipped"
    },
    "comment_id": {
      "type": "string",
      "description": "DAG Comment ID that was tipped (if tipping comment)"
    },
    "from_username": {
      "type": "string",
      "description": "Sender's username"
    },
    "to_username": {
      "type": "string",
      "description": "Recipient's username"
    },
    "message": {
      "type": "string",
      "description": "Optional message with tip"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "from_address",
    "to_address",
    "amount",
    "tx_hash"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": false,
    "delete": false
  }
}