{
  "name": "EvolveTransaction",
  "type": "object",
  "properties": {
    "experiment_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "job_code": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "agent_code": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "direction": {
      "type": "string",
      "enum": [
        "credit",
        "debit"
      ],
      "default": "credit"
    },
    "txid": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "CONFIRMED",
        "FAILED"
      ],
      "default": "PENDING"
    },
    "day": {
      "type": "number",
      "default": 0
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "amount"
  ]
}