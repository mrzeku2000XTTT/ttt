{
  "name": "AppRoadmap",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User who created this roadmap"
    },
    "app_idea": {
      "type": "string",
      "description": "Original app idea input"
    },
    "enhanced_idea": {
      "type": "string",
      "description": "AI-enhanced version of the idea"
    },
    "roadmap_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "completed": {
            "type": "boolean"
          }
        }
      },
      "description": "Array of roadmap phases with tasks"
    },
    "completed_tasks": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": [],
      "description": "Indices of completed tasks"
    },
    "progress_percentage": {
      "type": "number",
      "default": 0,
      "description": "Overall completion percentage"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "user_email",
    "app_idea"
  ],
  "rls": {
    "create": null,
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}