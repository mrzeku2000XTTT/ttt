{
  "name": "EvolveChainTx",
  "type": "object",
  "properties": {
    "experiment_id": {
      "type": "string"
    },
    "txid": {
      "type": "string",
      "description": "On-chain TN10 transaction id returned by Scorpion pushTx/sendKaspa"
    },
    "network": {
      "type": "string",
      "default": "kaspa_testnet_10"
    },
    "provider": {
      "type": "string",
      "enum": [
        "SCORPION",
        "KASWARE",
        "EXPERIMENT_SIGNER",
        "AGENT_WALLET"
      ],
      "default": "SCORPION"
    },
    "sender_actor_id": {
      "type": "string"
    },
    "sender_code": {
      "type": "string"
    },
    "sender_address": {
      "type": "string",
      "description": "kaspatest: sender"
    },
    "recipient_actor_id": {
      "type": "string"
    },
    "recipient_code": {
      "type": "string"
    },
    "recipient_address": {
      "type": "string",
      "description": "kaspatest: recipient"
    },
    "amount_sompi": {
      "type": "number",
      "default": 0,
      "description": "KAS amount in sompi (integer; 1 KAS = 100,000,000 sompi)"
    },
    "purpose": {
      "type": "string",
      "description": "EVOLVE economic purpose: TRADE, JOB_PAYMENT, ORG_CONTRIBUTION, HIRE_AI, BUILD, RESOURCE_PURCHASE, SERVICE_PAYMENT, CONTRACT_PAYMENT, DESCENDANT_FUNDING, GENESIS_FUNDING"
    },
    "world_ref": {
      "type": "string",
      "description": "Optional EVOLVE object reference (job id, trade id, contract id)"
    },
    "payment_intent_id": {
      "type": "string",
      "description": "Link to EvolvePaymentIntent record"
    },
    "reservation_id": {
      "type": "string",
      "description": "Link to EconomicReservation record"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Unique key preventing duplicate payments"
    },
    "status": {
      "type": "string",
      "enum": [
        "CREATED",
        "AWAITING_SIGNATURE",
        "SIGNED",
        "BROADCAST",
        "CONFIRMING",
        "CONFIRMED",
        "SETTLED",
        "FAILED",
        "CANCELLED",
        "EXPIRED"
      ],
      "default": "CREATED"
    },
    "confirmations": {
      "type": "number",
      "default": 0
    },
    "required_confirmations": {
      "type": "number",
      "default": 1,
      "description": "TN10 confirmations needed for settlement"
    },
    "error": {
      "type": "string"
    },
    "broadcast_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "settled_at": {
      "type": "string",
      "format": "date-time"
    },
    "day": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "txid",
    "provider",
    "amount_sompi",
    "status"
  ],
  "rls": {
    "read": null,
    "create": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}