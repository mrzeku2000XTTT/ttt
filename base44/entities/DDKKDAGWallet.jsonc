{
  "name": "DDKKDAGWallet",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Owner email"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "KKDAG credit balance (1000 KKDAG \u2248 1 DD request)"
    },
    "total_funded": {
      "type": "number",
      "default": 0,
      "description": "Total credits ever added to this wallet"
    },
    "total_spent": {
      "type": "number",
      "default": 0,
      "description": "Total credits ever consumed by the DD agent"
    },
    "credited_txids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Kaspa txids that have already been credited as KKDAG funding (prevents double-credit)"
    }
  },
  "required": [
    "user_email",
    "balance"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}