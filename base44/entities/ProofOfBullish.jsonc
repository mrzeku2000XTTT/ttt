{
  "name": "ProofOfBullish",
  "type": "object",
  "properties": {
    "media_url": {
      "type": "string",
      "description": "Uploaded photo or video URL"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "description": "Type of media"
    },
    "message": {
      "type": "string",
      "description": "User's bullish message"
    },
    "proof_link": {
      "type": "string",
      "description": "Link attached as proof (transaction or other)"
    },
    "transaction_hash": {
      "type": "string",
      "description": "1 KAS self-transaction hash"
    },
    "kasware_address": {
      "type": "string",
      "description": "User's Kasware wallet address"
    },
    "likes": {
      "type": "number",
      "default": 0,
      "description": "Number of likes"
    },
    "tips_received": {
      "type": "number",
      "default": 0,
      "description": "Total KAS tips received on this reel"
    },
    "video_duration": {
      "type": "number",
      "description": "Video duration in seconds"
    }
  },
  "required": [
    "media_url",
    "media_type",
    "transaction_hash",
    "kasware_address"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}