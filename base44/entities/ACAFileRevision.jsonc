{
  "name": "ACAFileRevision",
  "type": "object",
  "properties": {
    "computer_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "file_id": {
      "type": "string"
    },
    "storage_reference": {
      "type": "string"
    },
    "size_bytes": {
      "type": "number"
    },
    "sha256": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "filename": {
      "type": "string"
    },
    "previous_revision_id": {
      "type": "string"
    },
    "execution_id": {
      "type": "string"
    }
  },
  "required": [
    "computer_id",
    "file_id",
    "storage_reference",
    "size_bytes",
    "sha256",
    "mime_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}