{
  "name": "IWorkProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Worker email"
    },
    "wallet_address": {
      "type": "string",
      "description": "Kaspa wallet address"
    },
    "agentzk_username": {
      "type": "string",
      "description": "Agent ZK username"
    },
    "full_name": {
      "type": "string",
      "description": "Full name"
    },
    "kns_card_data": {
      "type": "string",
      "description": "Imported KNS card data"
    },
    "skills_description": {
      "type": "string",
      "description": "What the worker can do"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Parsed skills"
    },
    "availability": {
      "type": "string",
      "enum": [
        "full_time",
        "part_time",
        "contract",
        "flexible"
      ],
      "default": "flexible",
      "description": "Availability"
    },
    "hourly_rate_usd": {
      "type": "number",
      "description": "Hourly rate in USD"
    },
    "verified_by_ying": {
      "type": "boolean",
      "default": false,
      "description": "Verified by Agent Ying"
    },
    "resume_url": {
      "type": "string",
      "description": "Resume URL"
    },
    "portfolio_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Portfolio links"
    },
    "matched_jobs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Job IDs matched with"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Active worker"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "user_email",
    "wallet_address",
    "skills_description"
  ],
  "rls": {
    "create": {
      "user_email": "{{user.email}}"
    },
    "read": true,
    "update": {
      "user_email": "{{user.email}}"
    },
    "delete": {
      "user_email": "{{user.email}}"
    }
  }
}