{
  "name": "DuelLobby",
  "type": "object",
  "properties": {
    "lobby_code": {
      "type": "string",
      "description": "Unique lobby code"
    },
    "host_email": {
      "type": "string",
      "description": "Host user email"
    },
    "host_username": {
      "type": "string",
      "description": "Host username from TTT Feed"
    },
    "host_wallet": {
      "type": "string",
      "description": "Host wallet address"
    },
    "guest_email": {
      "type": "string",
      "description": "Guest user email"
    },
    "guest_username": {
      "type": "string",
      "description": "Guest username from TTT Feed"
    },
    "guest_wallet": {
      "type": "string",
      "description": "Guest wallet address"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "ready",
        "playing",
        "finished"
      ],
      "default": "waiting",
      "description": "Current lobby status"
    },
    "game_type": {
      "type": "string",
      "enum": [
        "quick_draw",
        "reaction_time",
        "math_battle"
      ],
      "default": "quick_draw",
      "description": "Type of duel game"
    },
    "winner_email": {
      "type": "string",
      "description": "Winner's email"
    },
    "host_score": {
      "type": "number",
      "default": 0,
      "description": "Host final score"
    },
    "guest_score": {
      "type": "number",
      "default": 0,
      "description": "Guest final score"
    },
    "bet_amount": {
      "type": "number",
      "default": 0,
      "description": "KAS bet amount"
    },
    "current_target": {
      "type": "string",
      "description": "Current target position for synchronized gameplay"
    },
    "target_spawn_time": {
      "type": "number",
      "description": "Timestamp when target was spawned"
    },
    "game_time_left": {
      "type": "number",
      "description": "Seconds remaining in game"
    }
  },
  "required": [
    "lobby_code",
    "host_email",
    "host_username"
  ]
}