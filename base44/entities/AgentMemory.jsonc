{
  "name": "AgentMemory",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User this memory belongs to"
    },
    "short_term": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "number"
          },
          "goal": {
            "type": "string"
          },
          "result": {
            "type": "object"
          }
        }
      },
      "description": "Recent interactions (last 10)"
    },
    "long_term": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "stored": {
            "type": "number"
          },
          "accessed": {
            "type": "number"
          },
          "access_count": {
            "type": "number"
          }
        }
      },
      "description": "Persistent knowledge"
    },
    "episodic": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "number"
          },
          "goal": {
            "type": "string"
          },
          "steps": {
            "type": "array"
          },
          "outcome": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          }
        }
      },
      "description": "Past completed tasks"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}