{
  "name": "AppProposal",
  "type": "object",
  "properties": {
    "app_name": {
      "type": "string",
      "description": "Name of the proposed app"
    },
    "app_link": {
      "type": "string",
      "description": "Live deployment URL (e.g. Vercel) \u2014 iframed in the App Store"
    },
    "github_url": {
      "type": "string",
      "description": "Open-source GitHub repo URL for AI audit / review"
    },
    "icon_url": {
      "type": "string",
      "description": "URL of the preferred icon image"
    },
    "description": {
      "type": "string",
      "description": "Description of the app"
    },
    "category": {
      "type": "string",
      "description": "App category (Tools, Games, etc.)"
    },
    "submitter_email": {
      "type": "string",
      "description": "Email of the user who submitted"
    },
    "submitter_name": {
      "type": "string",
      "description": "Name of the submitter"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Proposal status"
    },
    "audit_status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "passed",
        "flagged"
      ],
      "default": "pending",
      "description": "AI audit status"
    },
    "audit_verdict": {
      "type": "string",
      "enum": [
        "safe",
        "suspicious",
        "malicious",
        "unknown"
      ],
      "default": "unknown",
      "description": "AI audit verdict"
    },
    "audit_notes": {
      "type": "string",
      "description": "AI audit findings / notes"
    },
    "audit_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the AI audit was last run"
    },
    "admin_notes": {
      "type": "string",
      "description": "Admin notes/feedback"
    }
  },
  "required": [
    "app_name",
    "app_link",
    "description"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "data.submitter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}