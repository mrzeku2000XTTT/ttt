{
  "name": "CustomBullDate",
  "type": "object",
  "properties": {
    "eclipse_date": {
      "type": "string",
      "format": "date-time",
      "description": "Custom eclipse date set by admin"
    },
    "eclipse_type": {
      "type": "string",
      "enum": [
        "solar",
        "lunar",
        "custom"
      ],
      "default": "custom",
      "description": "Type of eclipse"
    },
    "description": {
      "type": "string",
      "description": "Optional description"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this date is active"
    }
  },
  "required": [
    "eclipse_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}