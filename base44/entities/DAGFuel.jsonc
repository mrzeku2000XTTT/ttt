{
  "name": "DAGFuel",
  "type": "object",
  "properties": {
    "donor_address": {
      "type": "string",
      "description": "Address that made the donation"
    },
    "donor_email": {
      "type": "string",
      "description": "Email if logged in"
    },
    "amount": {
      "type": "number",
      "description": "KAS donated"
    },
    "fuel_type": {
      "type": "string",
      "enum": [
        "cycling",
        "boost"
      ],
      "default": "cycling",
      "description": "Type of fuel purchased"
    },
    "tx_hash": {
      "type": "string",
      "description": "Transaction hash of donation"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "active",
        "depleted"
      ],
      "default": "pending",
      "description": "Fuel status"
    },
    "utxos_created": {
      "type": "number",
      "default": 0,
      "description": "Number of UTXOs created from this donation"
    },
    "transactions_sent": {
      "type": "number",
      "default": 0,
      "description": "Number of transactions broadcast"
    },
    "tps_contribution": {
      "type": "number",
      "default": 0,
      "description": "Current TPS this donation generates"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When boost fuel expires (null for cycling)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "amount",
    "fuel_type"
  ]
}