{
  "name": "Review",
  "type": "object",
  "properties": {
    "trade_id": {
      "type": "string",
      "description": "Reference to trade"
    },
    "reviewer_address": {
      "type": "string",
      "description": "Who left the review"
    },
    "reviewee_address": {
      "type": "string",
      "description": "Who is being reviewed"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Star rating 1-5"
    },
    "comment": {
      "type": "string",
      "description": "Review comment"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "trade_id",
    "reviewer_address",
    "reviewee_address",
    "rating"
  ]
}