{
  "name": "DAGComment",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "Reference to DAG post"
    },
    "parent_comment_id": {
      "type": "string",
      "description": "Parent comment if this is a reply"
    },
    "content": {
      "type": "string",
      "description": "Comment text"
    },
    "author_name": {
      "type": "string",
      "description": "Author username"
    },
    "author_wallet_address": {
      "type": "string",
      "description": "Author's wallet address"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "Author's role"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Whether comment is visible to all users"
    },
    "made_public_at": {
      "type": "string",
      "format": "date-time",
      "description": "When comment was made public"
    },
    "self_pay_tx_hash": {
      "type": "string",
      "description": "Transaction hash of 1 KAS self-payment"
    },
    "likes": {
      "type": "number",
      "default": 0,
      "description": "Number of likes"
    },
    "replies_count": {
      "type": "number",
      "default": 0,
      "description": "Number of replies"
    },
    "tips_received": {
      "type": "number",
      "default": 0,
      "description": "Total tips in KAS"
    },
    "media_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "description": "Media files"
    }
  },
  "required": [
    "post_id",
    "content",
    "author_name"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}