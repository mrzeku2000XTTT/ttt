{
  "name": "ZKEndpoint",
  "type": "object",
  "properties": {
    "endpoint_name": {
      "type": "string",
      "description": "Name of the endpoint (e.g., 'getUserData')"
    },
    "endpoint_path": {
      "type": "string",
      "description": "URL path (e.g., '/api/user-data')"
    },
    "method": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
      ],
      "default": "GET",
      "description": "HTTP method"
    },
    "description": {
      "type": "string",
      "description": "What this endpoint does"
    },
    "code": {
      "type": "string",
      "description": "JavaScript code to execute"
    },
    "response_type": {
      "type": "string",
      "enum": [
        "json",
        "html",
        "text"
      ],
      "default": "json",
      "description": "Response format"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether endpoint is active"
    },
    "requires_auth": {
      "type": "boolean",
      "default": false,
      "description": "Whether endpoint requires authentication"
    },
    "example_request": {
      "type": "string",
      "description": "Example request JSON"
    },
    "example_response": {
      "type": "string",
      "description": "Example response JSON"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for categorization"
    },
    "call_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times called"
    }
  },
  "required": [
    "endpoint_name",
    "endpoint_path",
    "method",
    "code"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.is_active": true
        }
      ]
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}