{
  "name": "PostLike",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "Reference to the post"
    },
    "user_email": {
      "type": "string",
      "description": "Email of user who liked"
    },
    "user_wallet": {
      "type": "string",
      "description": "Wallet address of user who liked"
    }
  },
  "required": [
    "post_id"
  ],
  "rls": {
    "create": true,
    "read": true,
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}