{
  "name": "PostLike",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "Reference to the post"
    },
    "user_email": {
      "type": "string",
      "description": "Email of user who liked"
    },
    "user_wallet": {
      "type": "string",
      "description": "Wallet address of user who liked"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "post_id"
  ],
  "rls": {
    "create": true,
    "read": true,
    "delete": true
  }
}