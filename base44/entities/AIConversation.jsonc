{
  "name": "AIConversation",
  "type": "object",
  "properties": {
    "user_wallet_address": {
      "type": "string",
      "description": "Wallet address of the user"
    },
    "user_email": {
      "type": "string",
      "description": "User email if logged in"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      },
      "description": "Full conversation messages"
    },
    "conversation_type": {
      "type": "string",
      "enum": [
        "market_analysis",
        "technical_help",
        "general_question",
        "whale_tracking",
        "news"
      ],
      "description": "Type of conversation"
    },
    "last_interaction": {
      "type": "string",
      "format": "date-time",
      "description": "Last time user interacted"
    }
  },
  "required": [
    "user_wallet_address",
    "messages"
  ],
  "rls": {
    "create": true,
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}