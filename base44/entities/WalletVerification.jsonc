{
  "name": "WalletVerification",
  "type": "object",
  "properties": {
    "verification_id": {
      "type": "string",
      "description": "Unique verification block ID"
    },
    "user_email": {
      "type": "string",
      "description": "User email if logged in (optional for wallet-only)"
    },
    "wallet_address": {
      "type": "string",
      "description": "Wallet being verified in this block"
    },
    "wallet_type": {
      "type": "string",
      "enum": [
        "kasware_l1",
        "ttt_wallet",
        "zk_wallet"
      ],
      "description": "Type of wallet"
    },
    "signature": {
      "type": "string",
      "description": "Cryptographic signature of this verification"
    },
    "message": {
      "type": "string",
      "description": "Message that was signed"
    },
    "parent_verifications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of parent verification IDs (DAG references)"
    },
    "blue_score": {
      "type": "number",
      "default": 0,
      "description": "DAGKnight blue score - number of valid confirmations"
    },
    "dag_depth": {
      "type": "number",
      "default": 0,
      "description": "Depth in the verification DAG"
    },
    "is_genesis": {
      "type": "boolean",
      "default": false,
      "description": "Is this the first verification (genesis block)"
    },
    "verified_by": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "wallet_type": {
            "type": "string"
          },
          "wallet_address": {
            "type": "string"
          },
          "verification_id": {
            "type": "string"
          }
        }
      },
      "description": "Which other wallets have verified this one"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When this verification was created"
    },
    "dag_hash": {
      "type": "string",
      "description": "Hash of this verification block including parent hashes"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "verification_id",
    "wallet_address",
    "wallet_type",
    "signature"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}