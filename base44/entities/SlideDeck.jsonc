{
  "name": "SlideDeck",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Deck title"
    },
    "description": {
      "type": "string",
      "description": "Deck description"
    },
    "style": {
      "type": "string",
      "enum": [
        "kaspa",
        "fire",
        "neon",
        "luxury",
        "minimal",
        "ocean",
        "dark",
        "auto"
      ],
      "default": "auto",
      "description": "Overall visual style"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "rendering",
        "done",
        "error"
      ],
      "default": "draft",
      "description": "Render status"
    },
    "video_url": {
      "type": "string",
      "description": "Final rendered MP4 URL"
    },
    "total_slides": {
      "type": "number",
      "default": 0,
      "description": "Slide count at render time"
    },
    "total_duration": {
      "type": "number",
      "default": 0,
      "description": "Total duration in seconds"
    },
    "render_log": {
      "type": "string",
      "description": "Latest render progress or error"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Optional thumbnail URL"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}