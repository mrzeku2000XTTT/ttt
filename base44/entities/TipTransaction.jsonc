{
  "name": "TipTransaction",
  "type": "object",
  "properties": {
    "sender_wallet": {
      "type": "string",
      "description": "Wallet address of tipper"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of tipper (if logged in)"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of tipper"
    },
    "recipient_wallet": {
      "type": "string",
      "description": "Wallet address of recipient"
    },
    "recipient_email": {
      "type": "string",
      "description": "Email of recipient (if logged in)"
    },
    "recipient_name": {
      "type": "string",
      "description": "Display name of recipient"
    },
    "amount": {
      "type": "number",
      "description": "Tip amount (KAS or token amount)"
    },
    "token_type": {
      "type": "string",
      "enum": [
        "KAS",
        "KRC20"
      ],
      "default": "KAS",
      "description": "Type of token tipped"
    },
    "krc20_ticker": {
      "type": "string",
      "description": "KRC-20 token ticker if applicable (e.g., PACMAN, NACHO)"
    },
    "tx_hash": {
      "type": "string",
      "description": "Transaction hash from Kasware"
    },
    "post_id": {
      "type": "string",
      "description": "Post ID that was tipped (if applicable)"
    },
    "reel_id": {
      "type": "string",
      "description": "Bull Reel ID that was tipped (if applicable)"
    },
    "source": {
      "type": "string",
      "enum": [
        "feed",
        "reel",
        "feed_comment"
      ],
      "description": "Where the tip came from"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "sender_wallet",
    "recipient_wallet",
    "amount",
    "tx_hash"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": false,
    "delete": false
  }
}