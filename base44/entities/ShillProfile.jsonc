{
  "name": "ShillProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User who created this profile"
    },
    "avatar_url": {
      "type": "string",
      "description": "Avatar photo URL"
    },
    "background_url": {
      "type": "string",
      "description": "Background photo URL"
    },
    "kaspa_qr_url": {
      "type": "string",
      "description": "Kaspa Wallet QR Code URL (Legacy)"
    },
    "kaspa_address": {
      "type": "string",
      "description": "Kaspa Wallet Address"
    },
    "display_name": {
      "type": "string",
      "description": "Display name"
    },
    "bio": {
      "type": "string",
      "description": "Short bio"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          }
        }
      },
      "description": "Social links and URLs"
    },
    "views": {
      "type": "number",
      "default": 0,
      "description": "Profile views"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user.role": "admin"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user.role": "admin"
        }
      ]
    }
  }
}