{
  "name": "KlipzJob",
  "type": "object",
  "properties": {
    "wallet_address": {
      "type": "string",
      "description": "Kaspa wallet address \u2014 the user's identity, no email/login needed"
    },
    "tx_hash": {
      "type": "string",
      "description": "1 KAS payment transaction hash (verified on-chain)"
    },
    "video_id": {
      "type": "string",
      "description": "YouTube video id"
    },
    "video_title": {
      "type": "string"
    },
    "video_thumbnail": {
      "type": "string"
    },
    "clip_title": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "start_s": {
      "type": "number"
    },
    "end_s": {
      "type": "number"
    },
    "score": {
      "type": "number"
    },
    "amount_kas": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "paid",
        "delivered",
        "failed"
      ],
      "default": "delivered"
    },
    "mp4_url": {
      "type": "string",
      "description": "Direct MP4 source URL if fetched"
    }
  },
  "required": [
    "wallet_address",
    "video_id",
    "tx_hash"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}