{
  "name": "TTTID",
  "type": "object",
  "properties": {
    "kaspa_address": {
      "type": "string",
      "description": "Verified Kaspa address"
    },
    "seal_signature": {
      "type": "string",
      "description": "Kasware signature proving ownership (Kaspa Seal)"
    },
    "seal_message": {
      "type": "string",
      "description": "Message that was signed"
    },
    "ttt_id": {
      "type": "string",
      "description": "Unique TTT ID (first 8 chars of address)"
    },
    "display_name": {
      "type": "string",
      "description": "User's chosen display name"
    },
    "verified_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the seal was created"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this TTT ID is active"
    }
  },
  "required": [
    "kaspa_address",
    "seal_signature",
    "ttt_id"
  ]
}