{
  "name": "KAIConfig",
  "type": "object",
  "properties": {
    "config_key": {
      "type": "string",
      "description": "Config key name (e.g. 'avatar_video_url')"
    },
    "config_value": {
      "type": "string",
      "description": "Config value"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "config_key",
    "config_value"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}