{
  "name": "WatchParty",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Movie/show title"
    },
    "embed_url": {
      "type": "string",
      "description": "URL to embed"
    },
    "source": {
      "type": "string",
      "description": "Source platform (FMovies, KissKH, etc.)"
    },
    "host_name": {
      "type": "string",
      "description": "Host display name"
    },
    "host_wallet": {
      "type": "string",
      "description": "Host wallet address"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether party is still active"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "wallet": {
            "type": "string"
          },
          "joined_at": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "List of participants"
    },
    "current_timestamp": {
      "type": "number",
      "default": 0,
      "description": "Current playback position in seconds"
    },
    "max_participants": {
      "type": "number",
      "default": 50,
      "description": "Max number of participants"
    }
  },
  "required": [
    "title",
    "embed_url",
    "host_name"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}