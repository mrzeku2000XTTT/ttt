{
  "name": "TTTFollow",
  "type": "object",
  "properties": {
    "follower_wallet": {
      "type": "string",
      "description": "Wallet address of the follower"
    },
    "following_wallet": {
      "type": "string",
      "description": "Wallet address being followed"
    },
    "follower_name": {
      "type": "string",
      "description": "Display name of follower"
    },
    "following_name": {
      "type": "string",
      "description": "Display name of user being followed"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "follower_wallet",
    "following_wallet"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}