{
  "name": "TTTFollow",
  "type": "object",
  "properties": {
    "follower_wallet": {
      "type": "string",
      "description": "Wallet address of the follower"
    },
    "following_wallet": {
      "type": "string",
      "description": "Wallet address being followed"
    },
    "follower_name": {
      "type": "string",
      "description": "Display name of follower"
    },
    "following_name": {
      "type": "string",
      "description": "Display name of user being followed"
    }
  },
  "required": [
    "follower_wallet",
    "following_wallet"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}