{
  "name": "Referral",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to company"
    },
    "referrer_id": {
      "type": "string",
      "description": "Reference to employee who referred"
    },
    "referrer_email": {
      "type": "string",
      "description": "Email of referrer"
    },
    "referrer_name": {
      "type": "string",
      "description": "Name of referrer"
    },
    "candidate_name": {
      "type": "string",
      "description": "Candidate full name"
    },
    "candidate_email": {
      "type": "string",
      "description": "Candidate email"
    },
    "candidate_phone": {
      "type": "string",
      "description": "Candidate phone"
    },
    "candidate_linkedin": {
      "type": "string",
      "description": "Candidate LinkedIn URL"
    },
    "position": {
      "type": "string",
      "description": "Position applied for"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "reviewing",
        "interviewing",
        "offer_extended",
        "hired",
        "rejected"
      ],
      "default": "submitted",
      "description": "Current status"
    },
    "referral_source": {
      "type": "string",
      "enum": [
        "link",
        "manual"
      ],
      "description": "How referral was submitted"
    },
    "bonus_amount": {
      "type": "number",
      "description": "Bonus amount for this referral"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "submitted_date": {
      "type": "string",
      "format": "date-time",
      "description": "When referral was submitted"
    },
    "hire_date": {
      "type": "string",
      "format": "date-time",
      "description": "When candidate was hired"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "description": "History of status changes"
    }
  },
  "required": [
    "company_id",
    "referrer_id",
    "candidate_name",
    "candidate_email",
    "position"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}