{
  "name": "KivRContact",
  "type": "object",
  "properties": {
    "from_address": {
      "type": "string",
      "description": "Wallet address of the person who saved this contact"
    },
    "contact_name": {
      "type": "string",
      "description": "Name the user calls this contact (e.g. 'Bills', 'Mom', 'Rent')"
    },
    "kaspa_address": {
      "type": "string",
      "description": "Kaspa address of the contact"
    },
    "default_amount": {
      "type": "number",
      "description": "Default amount to send (optional)"
    },
    "pin_hash": {
      "type": "string",
      "description": "Hashed PIN to authorize payments to this contact"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes about this contact"
    }
  },
  "required": [
    "from_address",
    "contact_name",
    "kaspa_address"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}