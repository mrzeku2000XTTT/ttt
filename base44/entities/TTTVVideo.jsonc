{
  "name": "TTTVVideo",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Video title"
    },
    "video_id": {
      "type": "string",
      "description": "YouTube video ID"
    },
    "thumbnail": {
      "type": "string",
      "description": "Thumbnail URL"
    },
    "category": {
      "type": "string",
      "enum": [
        "Viral Hits",
        "Music Legends",
        "Gaming",
        "Comedy",
        "Movies & Trailers",
        "Education",
        "Stock Market",
        "Crypto & Bitcoin",
        "Elon Musk",
        "Donald Trump",
        "War & Conflicts",
        "Trending Now"
      ],
      "description": "Video category"
    },
    "description": {
      "type": "string",
      "description": "Video description"
    },
    "views": {
      "type": "number",
      "default": 0,
      "description": "View count"
    },
    "duration": {
      "type": "string",
      "description": "Video duration (e.g., '10:30')"
    },
    "is_trending": {
      "type": "boolean",
      "default": false,
      "description": "Featured in Trending Now"
    },
    "added_date": {
      "type": "string",
      "format": "date-time",
      "description": "When video was added"
    }
  },
  "required": [
    "title",
    "video_id",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}