{
  "name": "AgentZKAccessCode",
  "type": "object",
  "properties": {
    "access_code": {
      "type": "string",
      "description": "Unique access code (e.g., AGENTZK-IPHONE-12345)"
    },
    "user_email": {
      "type": "string",
      "description": "Email of user this code is for"
    },
    "kaspa_address": {
      "type": "string",
      "description": "Kaspa address of user (for code generation)"
    },
    "is_used": {
      "type": "boolean",
      "default": false,
      "description": "Whether code has been used"
    },
    "used_by_email": {
      "type": "string",
      "description": "Email of user who used the code"
    },
    "used_date": {
      "type": "string",
      "format": "date-time",
      "description": "When code was used"
    },
    "created_by_admin": {
      "type": "string",
      "description": "Admin who created this code"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When code expires"
    },
    "max_uses": {
      "type": "number",
      "default": 1,
      "description": "How many times code can be used"
    },
    "use_count": {
      "type": "number",
      "default": 0,
      "description": "How many times code has been used"
    }
  },
  "required": [
    "access_code",
    "created_by_admin"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}