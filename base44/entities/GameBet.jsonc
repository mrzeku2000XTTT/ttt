{
  "name": "GameBet",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "Reference to PredictionGame"
    },
    "game_number": {
      "type": "string"
    },
    "user_email": {
      "type": "string",
      "description": "User email (optional, for tracking)"
    },
    "user_wallet_address": {
      "type": "string",
      "description": "User's Kaspa address for payouts"
    },
    "side": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ]
    },
    "amount_kas": {
      "type": "number"
    },
    "amount_pacman": {
      "type": "number",
      "default": 0,
      "description": "PACMAN KRC-20 tokens bet"
    },
    "tx_hash_in": {
      "type": "string",
      "description": "Transaction hash of user's KAS deposit to escrow"
    },
    "tx_hash_pacman_in": {
      "type": "string",
      "description": "Transaction hash of user's PACMAN KRC-20 deposit to escrow"
    },
    "tx_hash_out": {
      "type": "string",
      "description": "Transaction hash of KAS payout (if won)"
    },
    "tx_hash_pacman_out": {
      "type": "string",
      "description": "Transaction hash of PACMAN KRC-20 payout (if won)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_deposit",
        "confirmed",
        "won",
        "lost",
        "refunded"
      ],
      "default": "pending_deposit"
    },
    "payout_kas": {
      "type": "number",
      "default": 0
    },
    "payout_pacman": {
      "type": "number",
      "default": 0,
      "description": "PACMAN KRC-20 payout amount"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether user verified their PIN for this game session"
    },
    "receipt": {
      "type": "object",
      "properties": {
        "result": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "total_pool_kas": {
          "type": "number"
        },
        "total_pool_pacman": {
          "type": "number"
        },
        "your_bet_kas": {
          "type": "number"
        },
        "your_bet_pacman": {
          "type": "number"
        },
        "your_side": {
          "type": "string"
        },
        "payout_kas": {
          "type": "number"
        },
        "payout_pacman": {
          "type": "number"
        },
        "kas_tx_hash": {
          "type": "string"
        },
        "pacman_tx_hash": {
          "type": "string"
        },
        "pacman_bonus": {
          "type": "number"
        },
        "pacman_tx_commit": {
          "type": "string"
        },
        "pacman_tx_reveal": {
          "type": "string"
        },
        "settled_at": {
          "type": "string"
        },
        "judge_reason": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "description": "Settlement receipt with full payout details"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "game_id",
    "game_number",
    "user_wallet_address",
    "side",
    "amount_kas"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}