{
  "name": "AgentAuditRecord",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Owner of this consensus record"
    },
    "auditor_agent_id": {
      "type": "string",
      "description": "Agent that audited the claim"
    },
    "auditor_agent_name": {
      "type": "string"
    },
    "summarizer_agent_id": {
      "type": "string",
      "description": "Agent that produced the claim"
    },
    "summarizer_agent_name": {
      "type": "string"
    },
    "subject_tx_id": {
      "type": "string",
      "description": "The Kaspa transaction the claim is about"
    },
    "claim": {
      "type": "string",
      "description": "The summary produced by the summarizer agent"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "verified",
        "rejected"
      ],
      "description": "Auditor verdict"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "mismatches": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "anchor_tx_id": {
      "type": "string",
      "description": "Auditor's self-send sign-off tx (only when verified)"
    },
    "audited_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "subject_tx_id",
    "claim",
    "verdict"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}