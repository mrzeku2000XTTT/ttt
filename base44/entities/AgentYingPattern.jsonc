{
  "name": "AgentYingPattern",
  "type": "object",
  "properties": {
    "pattern_id": {
      "type": "string",
      "description": "Unique pattern identifier"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "social",
        "content",
        "design",
        "code",
        "research",
        "photo",
        "general"
      ],
      "description": "Type of task this pattern recognizes"
    },
    "verification_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Rules extracted from successful verifications"
    },
    "confidence": {
      "type": "number",
      "description": "Pattern confidence score (0-1)"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Example explanations that match this pattern"
    },
    "usage_count": {
      "type": "number",
      "default": 0,
      "description": "How many times this pattern was matched"
    },
    "success_rate": {
      "type": "number",
      "default": 0,
      "description": "Success rate when using this pattern"
    },
    "learned_from": {
      "type": "string",
      "description": "User email who contributed this pattern"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "pattern_id",
    "task_type",
    "confidence"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}