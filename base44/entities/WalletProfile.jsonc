{
  "name": "WalletProfile",
  "type": "object",
  "properties": {
    "wallet_address": {
      "type": "string",
      "description": "Primary wallet address (Kasware/TTT)"
    },
    "username": {
      "type": "string",
      "description": "Display username"
    },
    "bio": {
      "type": "string",
      "description": "User biography"
    },
    "profile_photo": {
      "type": "string",
      "description": "Profile photo URL"
    },
    "current_job": {
      "type": "string",
      "description": "Current job title"
    },
    "email": {
      "type": "string",
      "description": "Associated email if user logged in"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Last profile update"
    }
  },
  "required": [
    "wallet_address"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}