{
  "name": "AgentZKConnection",
  "type": "object",
  "properties": {
    "requester_email": {
      "type": "string",
      "description": "User who initiated connection"
    },
    "requester_address": {
      "type": "string",
      "description": "Requester's Kaspa address"
    },
    "target_address": {
      "type": "string",
      "description": "Target Kaspa address to connect to"
    },
    "target_email": {
      "type": "string",
      "description": "Target user's email if found"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "blocked"
      ],
      "default": "accepted",
      "description": "Connection status"
    },
    "conversation_id": {
      "type": "string",
      "description": "Unique conversation thread ID"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sender": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      },
      "description": "Messages in this connection"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last message timestamp"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether connection is active"
    }
  },
  "required": [
    "requester_email",
    "requester_address",
    "target_address"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": {
      "$or": [
        {
          "requester_email": "{{user.email}}"
        },
        {
          "target_email": "{{user.email}}"
        }
      ]
    }
  }
}