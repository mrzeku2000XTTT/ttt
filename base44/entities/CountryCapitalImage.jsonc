{
  "name": "CountryCapitalImage",
  "type": "object",
  "properties": {
    "country_name": {
      "type": "string",
      "description": "Name of the country"
    },
    "capital_name": {
      "type": "string",
      "description": "Name of the capital city"
    },
    "image_url": {
      "type": "string",
      "description": "AI-generated image URL"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the image was generated"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "country_name",
    "capital_name",
    "image_url"
  ]
}