{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "kaspa_address": {
      "type": "string",
      "description": "User's Kaspa wallet address (from Kasware or FluxKmail)"
    },
    "display_name": {
      "type": "string",
      "description": "User's display name for RufzeitK"
    },
    "is_online": {
      "type": "boolean",
      "default": false,
      "description": "Whether user is currently online"
    }
  },
  "required": [
    "kaspa_address",
    "display_name"
  ]
}