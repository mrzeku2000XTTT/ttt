{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Company name"
    },
    "admin_email": {
      "type": "string",
      "description": "Admin email for HR access"
    },
    "logo_url": {
      "type": "string",
      "description": "Company logo URL"
    },
    "size": {
      "type": "string",
      "enum": [
        "1-10",
        "11-50",
        "51-200",
        "201-500",
        "500+"
      ],
      "description": "Company size"
    },
    "bonus_amount": {
      "type": "number",
      "default": 1500,
      "description": "Referral bonus in USD"
    },
    "payment_timing": {
      "type": "string",
      "enum": [
        "immediate",
        "30_days",
        "90_days",
        "split"
      ],
      "default": "30_days",
      "description": "When bonuses are paid"
    },
    "eligible_positions": {
      "type": "string",
      "default": "all",
      "description": "Which positions are eligible"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Company status"
    }
  },
  "required": [
    "name",
    "admin_email",
    "size"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}