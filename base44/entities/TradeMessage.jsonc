{
  "name": "TradeMessage",
  "type": "object",
  "properties": {
    "trade_id": {
      "type": "string",
      "description": "Reference to trade"
    },
    "sender_address": {
      "type": "string",
      "description": "Message sender"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "trade_id",
    "sender_address",
    "message"
  ]
}