{
  "name": "UserActivity",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User performing action"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "view_item",
        "favorite_category",
        "search_product",
        "add_to_wishlist"
      ],
      "description": "Type of activity"
    },
    "item_id": {
      "type": "string",
      "description": "Related item ID"
    },
    "category": {
      "type": "string",
      "description": "Product category"
    },
    "metadata": {
      "type": "object",
      "description": "Additional activity data"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "user_email",
    "activity_type"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}