{
  "name": "SurvivalKnowledge",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "water",
        "food",
        "shelter",
        "defense",
        "medical",
        "communication",
        "navigation",
        "prophecy"
      ],
      "description": "Knowledge category"
    },
    "title": {
      "type": "string",
      "description": "Knowledge title"
    },
    "content": {
      "type": "string",
      "description": "Detailed knowledge content"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "description": "Skill level required"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Expert verified"
    },
    "success_count": {
      "type": "number",
      "default": 0,
      "description": "Times successfully used"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags"
    },
    "scripture_reference": {
      "type": "string",
      "description": "Biblical reference if applicable"
    }
  },
  "required": [
    "category",
    "title",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}