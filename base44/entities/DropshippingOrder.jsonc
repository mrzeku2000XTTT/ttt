{
  "name": "DropshippingOrder",
  "type": "object",
  "properties": {
    "creator_email": {
      "type": "string",
      "description": "Creator who owns the product"
    },
    "product_id": {
      "type": "string",
      "description": "Reference to DropshippingProduct"
    },
    "product_name": {
      "type": "string",
      "description": "Product name"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name"
    },
    "customer_address": {
      "type": "string",
      "description": "Shipping address"
    },
    "order_amount": {
      "type": "number",
      "description": "Order total in USD"
    },
    "profit": {
      "type": "number",
      "description": "Profit from this order"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "shipped",
        "delivered",
        "cancelled"
      ],
      "default": "pending",
      "description": "Order status"
    },
    "supplier_order_id": {
      "type": "string",
      "description": "Order ID from supplier"
    },
    "tracking_number": {
      "type": "string",
      "description": "Shipping tracking number"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "creator_email",
    "product_id",
    "product_name",
    "order_amount"
  ],
  "rls": {
    "create": true,
    "read": {
      "creator_email": "{{user.email}}"
    },
    "update": {
      "creator_email": "{{user.email}}"
    },
    "delete": {
      "creator_email": "{{user.email}}"
    }
  }
}