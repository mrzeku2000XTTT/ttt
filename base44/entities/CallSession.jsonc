{
  "name": "CallSession",
  "type": "object",
  "properties": {
    "caller_email": {
      "type": "string",
      "description": "Email of the user initiating the call"
    },
    "receiver_email": {
      "type": "string",
      "description": "Email of the user receiving the call"
    },
    "caller_kaspa_address": {
      "type": "string",
      "description": "Kaspa address of caller"
    },
    "receiver_kaspa_address": {
      "type": "string",
      "description": "Kaspa address of receiver"
    },
    "room_name": {
      "type": "string",
      "description": "Unique Jitsi room name"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "ended",
        "declined",
        "missed"
      ],
      "default": "pending",
      "description": "Current call status"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the call started"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the call ended"
    }
  },
  "required": [
    "caller_email",
    "receiver_email",
    "room_name"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.caller_email": "{{user.email}}"
        },
        {
          "data.receiver_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.caller_email": "{{user.email}}"
        },
        {
          "data.receiver_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}