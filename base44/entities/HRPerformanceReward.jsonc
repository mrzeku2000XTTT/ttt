{
  "name": "HRPerformanceReward",
  "type": "object",
  "properties": {
    "employee_email": {
      "type": "string",
      "description": "Employee who earned reward"
    },
    "employee_name": {
      "type": "string",
      "description": "Employee name"
    },
    "achievement_type": {
      "type": "string",
      "enum": [
        "perfect_attendance",
        "top_performer",
        "training_complete",
        "referral_bonus",
        "peer_recognition",
        "milestone_reached"
      ],
      "description": "Type of achievement"
    },
    "achievement_name": {
      "type": "string",
      "description": "Achievement name"
    },
    "reward_kas": {
      "type": "number",
      "description": "KAS reward amount"
    },
    "reward_usd": {
      "type": "number",
      "description": "USD equivalent"
    },
    "description": {
      "type": "string",
      "description": "Achievement description"
    },
    "badge_url": {
      "type": "string",
      "description": "NFT badge image URL"
    },
    "claimed": {
      "type": "boolean",
      "default": false,
      "description": "Whether reward was claimed"
    },
    "company_id": {
      "type": "string",
      "description": "Company owner email"
    }
  },
  "required": [
    "employee_email",
    "employee_name",
    "achievement_type",
    "achievement_name",
    "reward_kas",
    "company_id"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "company_id": "{{user.email}}"
    }
  }
}