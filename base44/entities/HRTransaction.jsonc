{
  "name": "HRTransaction",
  "type": "object",
  "properties": {
    "employee_email": {
      "type": "string",
      "description": "Employee receiving payment"
    },
    "employee_name": {
      "type": "string",
      "description": "Employee name"
    },
    "type": {
      "type": "string",
      "enum": [
        "salary",
        "bonus",
        "expense_reimbursement",
        "pto_payout"
      ],
      "description": "Transaction type"
    },
    "amount_usd": {
      "type": "number",
      "description": "Amount in USD"
    },
    "amount_kas": {
      "type": "number",
      "description": "Amount in KAS"
    },
    "kas_price_at_time": {
      "type": "number",
      "description": "KAS price when transaction made"
    },
    "from_wallet": {
      "type": "string",
      "description": "Company wallet address"
    },
    "to_wallet": {
      "type": "string",
      "description": "Employee wallet address"
    },
    "tx_hash": {
      "type": "string",
      "description": "Kaspa transaction hash"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed"
      ],
      "default": "pending",
      "description": "Transaction status"
    },
    "description": {
      "type": "string",
      "description": "Transaction description"
    },
    "company_id": {
      "type": "string",
      "description": "Company owner email"
    }
  },
  "required": [
    "employee_email",
    "employee_name",
    "type",
    "amount_usd",
    "amount_kas",
    "status",
    "company_id"
  ],
  "rls": {
    "create": true,
    "read": true
  }
}