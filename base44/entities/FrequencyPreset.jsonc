{
  "name": "FrequencyPreset",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User who created the preset"
    },
    "name": {
      "type": "string",
      "description": "Name of the preset"
    },
    "frequencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "hz": {
            "type": "number"
          },
          "duration": {
            "type": "number"
          }
        }
      },
      "description": "Array of frequencies in the routine"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Total duration in minutes"
    },
    "description": {
      "type": "string",
      "description": "Description of the preset"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a favorite preset"
    }
  },
  "required": [
    "user_email",
    "name",
    "frequencies"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}